/*
 * Nextflow Configuration for AliSim vs INDELible Comparative Benchmark (research2)
 */

params {
    taxa          = 20
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths       = [1000]
    replicates    = 10

    // 系統樹生成モデル (Matsui & Iwasaki 2020 準拠)
    tree_model    = "paper_yule"
    rate_sd       = 0.0
    lba_ratio     = 1.0

    // Indel 設定 (Zipfian power-law)
    indel_size    = "POW 1.7 50"

    // 置換モデル (LG + Gamma4)
    model         = "LG+G4"
    alpha         = 1.0

    // ギャップペナルティ & NJ 設定 (PhyPA 準拠)
    gap_open      = 20.0
    gap_extend    = 2.0
    dist_model    = "poisson"
    nj_tool       = "rapidnj"

    outdir        = "research2/results"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 3

    cpus   = 1
    memory = '4 GB'
    time   = '3h'

    withName: SIMULATE_COMPARATIVE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '6 GB'
        time   = '3h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_SSS {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }

    withName: CALCULATE_PROPERTIES {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: COLLECT_AND_PLOT_RESEARCH2 {
        cpus     = 2
        memory   = '8 GB'
        time     = '1h'
        executor = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    local {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }

    test {
        params.taxa       = 20
        params.distances  = [0.5, 2.0]
        params.lengths    = [500]
        params.replicates = 1
        process.executor  = 'local'
        process.cpus      = 2
        process.memory    = '4 GB'
    }
}
