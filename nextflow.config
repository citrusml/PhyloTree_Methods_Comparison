/*
 * Nextflow Configuration for PhyloMethod Benchmark
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    distances  = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths    = [100, 300, 500, 1000, 1500]
    replicates = 100
    num_taxa   = 16
    sigma      = 0.5
    model      = "LG+G"
    alpha      = 1.0
    indel_rate = 0.05
    gap_open   = 10.0
    gap_extend = 0.5
    dist_model = "poisson"
    outdir     = "results"
    nj_tool    = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 3

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = '8 GB'
        time   = '4h'
    }

    withName: COLLECT_AND_PLOT {
        cpus   = 4
        memory = '16 GB'
        time   = '1h'
    }
}

executor {
    $lsf {
        queueSize         = 1000
        pollInterval      = '1sec'
        queueStatInterval = '5sec'
    }
}

profiles {
    supercomputer {
        params.distances  = [0.1, 0.5, 1.0, 2.0, 3.0]
        params.lengths    = [100, 300, 500, 1000, 1500]
        params.replicates = 100
    }

    local {
        params.distances  = [0.1, 1.0]
        params.lengths    = [100, 500]
        params.replicates = 5
        process {
            executor = 'local'
            cpus     = 4
            memory   = '8 GB'
        }
        executor {
            cpus = 4
        }
    }
}

manifest {
    name            = 'PhyloMethod Benchmark'
    description     = 'PWA+NJ vs MSA+ML Regime Map Benchmark Pipeline for LSF Cluster'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}
