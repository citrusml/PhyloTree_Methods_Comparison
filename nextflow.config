/*
 * Nextflow Configuration for PhyloMethod Benchmark
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    distances  = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths    = [50, 100, 300, 500, 1000]
    replicates = 100
    num_taxa   = 16
    outdir     = "results"
    nj_tool    = "rapidnj"
}

profiles {
    local {
        params.distances  = [0.1, 1.0]
        params.lengths    = [100, 500]
        params.replicates = 5
        process.executor  = 'local'
        executor.cpus     = 4
    }

    supercomputer {
        params.distances  = [0.1, 0.5, 1.0, 2.0, 3.0]
        params.lengths    = [50, 100, 300, 500, 1000]
        params.replicates = 100

        process {
            executor = 'lsf'
            queue    = 'normal'

            // Default fallback resource limit
            cpus   = 1
            memory = '4 GB'
            time   = '2h'

            // Fine-tuned resource specs matching mafftsrv1-5 capacity
            withName: SIMULATE_DATA {
                cpus   = 1
                memory = '2 GB'
                time   = '30m'
            }

            withName: RUN_PWA_NJ {
                cpus   = 1
                memory = '4 GB'
                time   = '1h'
            }

            withName: RUN_MSA_NJ {
                cpus   = 2
                memory = '4 GB'
                time   = '1h'
            }

            withName: RUN_MSA_ML {
                // Heavy IQ-TREE 2 ModelFinder + ML tree search uses 4 threads
                // L=1000 can take up to ~20 min per job; 4h limit is generous margin
                cpus   = 4
                memory = '8 GB'
                time   = '4h'
            }

            withName: COLLECT_AND_PLOT {
                cpus   = 4
                memory = '16 GB'
                time   = '1h'
            }
        }

        // Executor tuning for 5x 32-core nodes (160 total physical CPUs)
        executor {
            queueSize         = 160
            submitRateLimit   = '10/1sec'
            pollInterval      = '5sec'
        }
    }
}

manifest {
    name            = 'PhyloMethod Benchmark'
    description     = 'PWA+NJ vs MSA+ML Regime Map Benchmark Pipeline for LSF Cluster'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}
