/*
 * Nextflow Configuration for PhyloMethod True PWA Benchmark (Batch Chunking: 10 reps/job)
 * Experiment 4: True Pairwise Alignment (TRUE_PWA+NJ) Benchmark (N = 32 taxa)
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa        = 32
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 300, 500, 1000, 1500]
    replicates  = 100
    chunk_size  = 10                        // 10 replicates を 1つの LSF ジョブにバッチ集約
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG+G4"
    alpha       = 1.0
    gap_open    = 10.0
    gap_extend  = 0.5
    dist_model  = "poisson"
    outdir      = "results/results_true_pwa"
    nj_tool     = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '1h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 200       // バッチ化により総ジョブ数が 250 になるため 200 で十分全ノードを満杯にできる
    pollInterval      = '2sec'
    queueStatInterval = '5sec'
    submitRateLimit   = '30/1sec'
}

profiles {
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }
}

manifest {
    name            = 'PhyloMethod True PWA Benchmark'
    description     = 'True Pairwise Alignment vs True Tree Benchmark Pipeline for LSF Cluster'
    mainScript      = 'main_true_pwa.nf'
    nextflowVersion = '>=23.04.0'
}
