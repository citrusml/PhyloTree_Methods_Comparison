/*
 * Nextflow Configuration for Full-length Invariant Category Sites (ICS Full) Benchmark
 * 実験17: 全長 (100%) Dayhoff 6-category Invariant Sites + Indel ベンチマーク
 *
 * 設定内容:
 *   - 置換モデル: ICS+G4 (alpha=1.0, models/ics_model.nex を使用)
 *   - 配列シミュレータ: AliSim (custom model definition --mdef 対応)
 *   - 系統樹生成モデル: 後退 Yule 過程 (paper_yule, 論文 Matsui & Iwasaki 2020 準拠)
 *   - Zipfian (Power-Law) べき乗則 Indel: POW{1.7/50} (べき指数 a=1.7, 最大 50 残基)
 *   - Indel 発生頻度: insert_rate=0.10, delete_rate=0.10
 *   - 比較手法: PWA+NJ, MSA+NJ, MSA+ML (IQ-TREE 2), MSA+RAXML, GS, 各種 True MSA 対照群
 *   - ギャップペナルティ: Gap Open = 20.0, Gap Extension = 2.0 (PhyPA / Xia 2016 準拠)
 *   - 距離・配列長: Distances [0.1, 0.2, 0.5, 1.0, 1.5, 2.0], Lengths [300, 500, 1000, 1500]
 */

params {
    taxa            = 32
    distances       = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths         = [300, 500, 1000, 1500]
    replicates      = 50
    chunk_size      = 5                        // 5 replicates を 1つの LSF ジョブにバッチ集約

    // シミュレータおよびICSモデル設定
    simulator       = "alisim"
    model           = "ICS+G4"
    alpha           = 1.0
    ics_prop        = 1.0                      // 全長 (100%) ICS
    ics_model_file  = "${projectDir}/models/ics_model.nex"

    // 系統樹生成モデル (Matsui & Iwasaki 2020 準拠)
    tree_model      = "paper_yule"              // 後退 Yule 過程 + 枝長分布 1 - ln(u*(e-1)+1)
    rate_sd         = 0.0                       // 速度不均一の標準偏差
    lba_ratio       = 1.0                       // 長枝牽引比率
    birth_rate      = 0.1                       // birth_death フォールバック用
    death_rate      = 0.05                      // birth_death フォールバック用

    // Zipfian べき乗則 Indel
    insert_rate     = 0.10                      // 挿入率 (置換率に対する相対値: 10%)
    delete_rate     = 0.10                      // 欠失率 (置換率に対する相対値: 10%)
    indel_size      = "POW{1.7/50},POW{1.7/50}" // Zipfian: べき指数 a=1.7, 最大 50 残基

    dist_model      = "poisson"
    gap_open        = 20.0
    gap_extend      = 2.0

    // =============================================================
    // パイプライン実行 ON / OFF スイッチ (個別モジュール制御)
    // =============================================================
    run_pwa_nj         = true   // Pairwise Alignment + NJ (PWA+NJ)
    run_msa_nj         = true   // MAFFT + NJ (MSA+NJ)
    run_msa_ml         = true   // MAFFT + IQ-TREE 2 (MSA+ML)
    run_msa_raxml      = true   // MAFFT + RAxML -f d
    run_msa_bi         = false  // MAFFT + MrBayes (MSA+BI)
    run_bi             = false  // run_msa_bi のエイリアス
    run_gs             = true   // Graph Splitting (GS / syz049 準拠)

    // 正解アライメント対照群 (True Controls)
    run_true_pwa       = true   // True Alignment + PWA + NJ
    run_true_msa_nj    = true   // True Alignment + NJ
    run_true_msa_ml    = true   // True Alignment + ML (IQ-TREE 2)
    run_true_msa_raxml = true   // True Alignment + RAxML -f d
    run_true_msa_bi    = false  // True Alignment + MrBayes (True MSA+BI)
    run_true_bi        = false  // run_true_msa_bi のエイリアス
    run_true_msa       = true   // 互換スイッチ (true_msa_nj, true_msa_ml を一括制御)
    calc_sss           = true   // SSS (Sequence Similarity Score) 計算

    // ツール詳細オプション
    raxml_model        = "PROTGAMMAIWAGX"
    bi_ngen            = 100000
    bi_samplefreq      = 1000
    bi_burnin          = 20
    bi_nchains         = 4
    bi_model           = "wag"
    gs_sensitivity     = 7.5
    outdir             = "results/results_ics_full"
    nj_tool            = "rapidnj"
}

env {
    ICS_PROP = '1.0'
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '3h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_BI {
        cpus   = 4
        memory = '8 GB'
        time   = '48h'
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_BI {
        cpus   = 4
        memory = '8 GB'
        time   = '48h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }

    test {
        params.taxa               = 8
        params.distances          = [0.5]
        params.lengths            = [300]
        params.replicates         = 1
        params.chunk_size         = 1
        params.run_msa_raxml      = false
        params.run_true_msa_raxml = false
        params.run_msa_bi         = false
        params.run_true_msa_bi    = false
        process.executor          = 'local'
        process.cpus              = 2
        process.memory            = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - ICS Full Benchmark'
    author          = 'CitrusML'
    homePage        = 'https://github.com/citrusml2004/PhyloTree_Methods_Comparison'
    description     = 'Benchmark of PWA+NJ, MSA+NJ, MSA+ML, GS under 100% Invariant Category Sites (ICS) with Indels.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '17.0.0'
}
