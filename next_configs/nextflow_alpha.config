/*
 * Nextflow Configuration for PhyloMethod Alpha Benchmark (alpha = 0.25, 0.5, 1.0, 2.0)
 * Experiment 3: Among-Site Rate Variation & Heterogeneity Benchmark (N = 32 taxa)
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa        = 32
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 500, 1000]
    replicates  = 100
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG+G4"
    alpha       = [0.25, 0.5, 1.0, 2.0]
    gap_open    = 10.0
    gap_extend  = 0.5
    dist_model  = "poisson"
    outdir      = "results/results_alpha"
    nj_tool     = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'  // Lustreファイルシステムでのキャッシュ判定を安定化
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = '4 GB'
        time   = '3h'
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 140       // mafftキュー全体の上限 (5 nodes x 32 CPUs = 160)
    pollInterval      = '5sec'
    queueStatInterval = '30sec'
    submitRateLimit   = '20/1sec' // bsub連打によるLSFデーモン過負荷を防ぐ
}

profiles {
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
        // executor.queueSize は上のexecutorブロックで設定済み（ここで上書きしない）
    }
}
