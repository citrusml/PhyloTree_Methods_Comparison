/*
 * Nextflow Configuration for PhyloMethod Gamma Distance Benchmark (Batch Chunking: 10 reps/job)
 * Experiment 5: Gamma-corrected distance (alpha_dist = 1.0) under rate heterogeneity (alpha = 0.25, 0.5, 1.0, 2.0)
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa        = 32
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 500, 1000]
    replicates  = 100
    chunk_size  = 10                        // 10 replicates を 1つの LSF ジョブにバッチ集約
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG+G4"
    alpha       = [0.25, 0.5, 1.0, 2.0]     // シミュレーション時の真の alpha
    dist_model  = "gamma_poisson"           // ガンマ補正ポアソン距離
    dist_alpha  = 1.0                       // 距離計算式で仮定する alpha (1.0固定)
    gap_open    = 10.0
    gap_extend  = 0.5
    outdir      = "results/results_gamma"
    nj_tool     = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'                      // 10 reps x 2min = 20min (安全マージン4h)
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 300       // バッチ化により総ジョブ数が 3,000 (プロセス別 600) になるため 300 で 160 コアを余裕で埋め尽くせる
    pollInterval      = '2sec'
    queueStatInterval = '5sec'
    submitRateLimit   = '30/1sec'
}

profiles {
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }
}

manifest {
    name            = 'PhyloMethod Gamma Distance Benchmark'
    description     = 'Gamma-corrected Poisson Distance Benchmark under Among-Site Rate Variation'
    mainScript      = 'main_gamma.nf'
    nextflowVersion = '>=23.04.0'
}
