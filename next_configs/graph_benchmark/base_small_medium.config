/*
 * Nextflow Configuration: Graph Benchmark Base (N <= 64)
 *
 * Default / OFAT Sweep Base:
 *   - D = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0, 3.0]
 *   - N = 32, L = 500, indel = 0.1, nelsi_v = 0.6, lba_ratio = 1.0, 100 reps
 *   - Methods:
 *       1. MSA+ML (IQ-TREE 2 MFP)
 *       2. MSA+ML_WAG_G4 (IQ-TREE 2 WAG+G4)
 *       3. MSA+NJ (poisson)
 *       4. PWA+NJ (poisson, BLOSUM62 open=10 extend=1)
 *       5. MMSEQS+NJ (sss linear)
 *       6. GS (poisson)
 *       7. NJ + FastME (NNI+SPR, BalME -n B -s)
 */

params {
    // Simulation Parameters (Default)
    taxa          = 32
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0, 3.0]
    lengths       = [500]
    replicates    = 100
    chunk_size    = 20

    // Tree model: Yule + NELSI Kishino Autocorrelated
    tree_model         = "nelsi_kishino"
    nelsi_v            = 0.6
    nelsi_initial_rate = 1.0
    nelsi_scale_mode   = "root_to_tip"
    rate_sd            = 0.0
    lba_ratio          = 1.0

    // Sequence simulator: INDELible (WAG+G4, POW 1.7 50, indel=0.1)
    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    // Substitution & Distance Models
    model             = "WAG+G4"
    alpha             = 1.0
    iqtree_model      = "MFP"
    iqtree_wag_model  = "WAG+G4"
    dist_model        = "poisson"
    psa_dist_model    = "poisson"
    mmseqs_dist_model = "linear"
    gap_open          = 10.0
    gap_extend        = 1.0

    // Pipeline Toggles
    run_pwa_nj       = true
    run_pwa_local_nj = true
    run_mmseqs_nj    = true
    run_msa_nj       = true
    run_nj_nni       = true
    nj_nni_type      = "B"
    nj_spr           = true
    run_msa_ml       = true
    run_msa_ml_wag   = true
    run_msa_raxml    = false
    run_msa_linsi    = false
    run_msa_bi       = false
    run_bi           = false
    run_gs           = true

    // True MSA / PWA baselines (OFF)
    run_true_pwa       = false
    run_true_msa_nj    = false
    run_true_msa_ml    = false
    run_true_msa_raxml = false
    run_true_msa_bi    = false
    run_true_bi        = false
    run_true_msa       = false

    // Output
    outdir           = "results/graph_benchmark/default_N32_L500_v06_lba1"

    // Tools
    nj_tool          = "rapidnj"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 3

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_PWA_LOCAL_NJ {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: RUN_MSA_ML_WAG {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 10.h * task.attempt }
    }

    withName: RUN_GS {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_NJ_NNI {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"'
    }

    test {
        params.taxa       = 16
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory    = '4 GB'
    }
}
