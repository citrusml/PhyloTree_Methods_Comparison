/*
 * Nextflow Configuration: Graph Benchmark Large Taxa (N = 128, 256)
 *
 * Inherits base parameters but scales down chunk_size and scales up
 * memory/time/CPUs for N=128 and N=256.
 */

includeConfig 'base_small_medium.config'

params {
    taxa       = 128
    chunk_size = 2
    outdir     = "results/graph_benchmark/taxa_N128_L500_v06_lba1"
}

process {
    withName: SIMULATE_DATA {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_PWA_NJ {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: RUN_MAFFT {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withName: RUN_MSA_ML_WAG {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withName: RUN_GS {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: RUN_NJ_NNI {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
