/*
 * Nextflow Configuration: NELSI Uncorrelated Lognormal (UCLN) Benchmark
 *
 * 1. Topology: Yule (pure-birth) tree generated via phytools::pbtree (in R/NELSI)
 * 2. Branch lengths: NELSI uncorrelated lognormal relaxed-clock model (simulate.uncor.lnorm)
 *    - nelsi_mean_log = 0.0, nelsi_sd_log = 0.5
 *    - nelsi_scale_mode = "root_to_tip" (root-to-tip mean distance scaled to target dist)
 * 3. Sequence evolution: INDELible (WAG+G4, insert_rate=0.10, delete_rate=0.10, POW 1.7 50)
 * 4. Pipelines: same active methods as nextflow_nelsi_yule.config (ML/RAxML/NJ/GS ON, BI OFF)
 */

params {
    // Simulation Parameters
    taxa          = 20
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths       = [500, 1000, 1500]
    replicates    = 100
    chunk_size    = 20

    // Tree model: NELSI Uncorrelated Lognormal (Yule topology + UCLN branch rates)
    tree_model         = "nelsi_uncor_lnorm"
    nelsi_mean_log     = 0.0
    nelsi_sd_log       = 0.5
    nelsi_v            = 0.3
    nelsi_initial_rate = 1.0
    nelsi_scale_mode   = "root_to_tip"
    rate_sd            = 0.0
    lba_ratio          = 1.0

    // Sequence simulator
    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    // Substitution & Distance Models
    model             = "WAG+G4"
    alpha             = 1.0
    dist_model        = "wag_gamma"
    psa_dist_model    = "mmseqs_linear"
    mmseqs_dist_model = "log"
    gap_open          = 20.0
    gap_extend        = 2.0

    // Pipeline Toggles (same as nextflow_nelsi_yule.config + NJ+NNI)
    run_pwa_nj       = true
    run_mmseqs_nj    = true
    run_msa_nj       = true
    run_nj_nni       = true
    nj_nni_type      = "B"
    run_msa_ml       = true
    run_msa_raxml    = true
    run_msa_linsi    = false
    run_msa_bi       = false
    run_bi           = false
    run_gs           = true

    // True MSA / PWA baselines
    run_true_pwa       = true
    run_true_msa_nj    = true
    run_true_msa_ml    = true
    run_true_msa_raxml = true
    run_true_msa_bi    = false
    run_true_bi        = false
    run_true_msa       = true

    // RAxML / GraphSplitting Settings
    raxml_model      = "PROTGAMMAIWAGX"
    gs_sensitivity   = 7.5

    // Output
    outdir           = "results/results_nelsi_uncor_lnorm"

    // Tools
    nj_tool          = "rapidnj"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '3h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: CALCULATE_ALIGNMENT_METRICS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_NJ_NNI {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory   = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - NELSI Uncorrelated Lognormal Benchmark'
    author          = 'CitrusML'
    description     = 'Yule topology + NELSI uncorrelated lognormal relaxed-clock branch-length simulation benchmark.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

