/*
 * Nextflow Configuration: NELSI (v=0.3) x LBA (3x) x WAG+G4 (No ICS) Benchmark
 *
 * 1. Tree model: Yule topology + NELSI Kishino autocorrelated model (nelsi_v = 0.3, lba_ratio = 3.0, root_to_tip = D)
 * 2. Sequence model: AliSim WAG+G4 (alpha=1.0, no ICS)
 * 3. Indel model: Zipfian POW{1.7/50}, insert_rate=0.10, delete_rate=0.10
 * 4. Conditions: taxa=20, distances=[0.1, 0.5, 1.0, 2.0, 3.0], lengths=[500], replicates=20
 * 5. Pipelines (6 methods):
 *    - MSA+ML (ModelFinder MFP): run_msa_ml = true, iqtree_model = "MFP"
 *    - MSA+ML_WAG_G4 (Fixed WAG+G4): run_msa_ml_wag = true, iqtree_wag_model = "WAG+G4"
 *    - MMSEQS+NJ (SSS linear): run_mmseqs_nj = true, mmseqs_dist_model = "linear"
 *    - MMSEQS+NJ_LOG (SSS log): run_mmseqs_log_nj = true
 *    - PSA+NJ (Poisson): run_pwa_nj = true, psa_dist_model = "poisson"
 *    - GS (Graph Splitting): run_gs = true
 */

params {
    // Simulation Parameters
    taxa          = 20
    distances     = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths       = [500]
    replicates    = 20
    chunk_size    = 10

    // Tree model: NELSI Kishino Autocorrelated (v = 0.3, lba_ratio = 3.0)
    tree_model         = "nelsi_kishino"
    nelsi_v            = 0.3
    nelsi_initial_rate = 1.0
    nelsi_scale_mode   = "root_to_tip"
    rate_sd            = 0.0
    lba_ratio          = 3.0

    // Sequence simulator: AliSim WAG+G4 (No ICS)
    simulator      = "alisim"
    model          = "WAG+G4"
    alpha          = 1.0
    ics_prop       = 0.0
    ics_model_file = "${projectDir}/models/ics_model.nex"

    // Zipfian Power-Law Indels
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW{1.7/50},POW{1.7/50}"

    // Distance & Alignment Settings
    dist_model        = "poisson"
    psa_dist_model    = "poisson"
    mmseqs_dist_model = "linear"
    iqtree_model      = "MFP"
    iqtree_wag_model  = "WAG+G4"
    gap_open          = 20.0
    gap_extend        = 2.0

    // Pipeline Toggles (6 requested methods only)
    run_msa_ml        = true
    run_msa_ml_wag    = true
    run_mmseqs_nj     = true
    run_mmseqs_log_nj = true
    run_pwa_nj        = true
    run_gs            = true

    run_msa_nj        = false
    run_msa_raxml     = false
    run_msa_linsi     = false
    run_msa_bi        = false
    run_bi            = false
    run_nj_nni        = false

    // True MSA / PWA baselines (OFF)
    run_true_pwa       = false
    run_true_msa_nj    = false
    run_true_msa_ml    = false
    run_true_msa_raxml = false
    run_true_msa_bi    = false
    run_true_bi        = false
    run_true_msa       = false

    // GraphSplitting & SSS Settings
    gs_sensitivity     = 7.5
    calc_sss           = true

    // Output
    outdir             = "results/results_nelsi_wag_lba3"

    // Tools
    nj_tool            = "rapidnj"
}

env {
    ICS_PROP = '0.0'
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '3h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: CALCULATE_ALIGNMENT_METRICS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MMSEQS_LOG_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_ML_WAG {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory   = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - NELSI (v=0.3) x LBA (3x) x WAG+G4 (No ICS)'
    author          = 'CitrusML'
    description     = 'NELSI Kishino (v=0.3, lba_ratio=3.0) + AliSim WAG+G4 (No ICS, L=500, rep=20) benchmark.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}
