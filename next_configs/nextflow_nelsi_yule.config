/*
 * Nextflow Configuration for NELSI Autocorrelated Yule Tree Benchmark
 *
 * 系統樹生成に R パッケージ NELSI の自己相関緩和時計モデルを使用:
 *   - トポロジー: Yule 純粋出生過程 (ape::rphylo, birth=1, death=0)
 *   - 枝長モデル: NELSI::simulate.autocor.kishino (Kishino et al. 2001)
 *                 または NELSI::simulate.autocor.thorne (Thorne et al. 1998)
 *   - スケーリング: 平均 root-to-tip 距離を各 D (distances) に一致 (scale_mode = "root_to_tip")
 *
 * 配列シミュレーションおよび距離計算・評価設定は nextflow_paper_tree4.config に準拠。
 */

params {
    taxa          = 20
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths       = [500, 1000, 1500]
    replicates    = 100
    chunk_size    = 20

    // 系統樹生成モデル (Yule トポロジー + NELSI 自己相関モデル)
    tree_model         = "nelsi_kishino"   // "nelsi_kishino" または "nelsi_thorne"
    nelsi_v            = 0.3               // 自己相関分散パラメータ v (大きいほど速度変動が大きい)
    nelsi_initial_rate = 1.0               // ルートの初期置換速度
    nelsi_scale_mode   = "root_to_tip"     // "root_to_tip", "mean_branch", または "raw"
    rate_sd            = 0.0
    lba_ratio          = 1.0
    birth_rate         = 0.1
    death_rate         = 0.05

    // シミュレータ指定 (INDELible v1.03)
    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    // 置換モデル・距離行列計算モデル
    model             = "WAG+G4"
    alpha             = 1.0
    dist_model        = "wag_gamma"
    psa_dist_model    = "mmseqs_linear"
    mmseqs_dist_model = "log"
    gap_open          = 20.0
    gap_extend        = 2.0

    // パイプライン実行 ON / OFF スイッチ
    run_pwa_nj       = true
    run_mmseqs_nj    = true
    run_msa_nj       = true
    run_msa_ml       = true
    run_msa_raxml    = true
    run_msa_linsi    = false
    run_msa_bi       = false
    run_bi           = false
    run_gs           = true

    // 正解アライメント対照群
    run_true_pwa       = true
    run_true_msa_nj    = true
    run_true_msa_ml    = true
    run_true_msa_raxml = true
    run_true_msa_bi    = false
    run_true_bi        = false
    run_true_msa       = true

    // 評価・解析・保存スイッチ
    calc_sp           = true
    save_replications = true
    calc_sss          = true

    // ツール詳細オプション
    raxml_model      = "PROTGAMMAIWAGX"
    bi_ngen          = 100000
    bi_samplefreq    = 1000
    bi_burnin        = 20
    bi_nchains       = 4
    bi_model         = "wag"
    gs_sensitivity   = 7.5
    outdir           = "results/results_nelsi_yule"
    nj_tool          = "rapidnj"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '3h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: CALCULATE_ALIGNMENT_METRICS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory   = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - NELSI Autocorrelated Yule Benchmark'
    author          = 'CitrusML'
    description     = 'Yule topology + NELSI autocorrelated branch-length tree simulation benchmark.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

