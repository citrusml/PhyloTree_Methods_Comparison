/*
 * Nextflow Configuration: NELSI Autocorrelated (Kishino) Taxa-Scaling Benchmark (N=128, L=500)
 *
 * 1. Topology & Branch lengths: Yule + NELSI Kishino autocorrelated model (nelsi_v = 0.3)
 * 2. Fixed sequence length: L = 500
 * 3. Taxa: 128
 * 4. Pipelines (5 methods):
 *    - SSS (MMseqs2) linear distance + NJ (run_mmseqs_nj = true, mmseqs_dist_model = "linear")
 *    - NW Poisson distance + NJ (run_pwa_nj = true, psa_dist_model = "poisson")
 *    - MSA + NJ (run_msa_nj = true, dist_model = "wag_gamma")
 *    - MSA + ML (run_msa_ml = true, iqtree_model = "WAG+G4")
 *    - MSA + RAxML (run_msa_raxml = true, raxml_model = "PROTGAMMAIWAGX")
 */

params {
    // Simulation Parameters
    taxa          = 128
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths       = [500]
    replicates    = 100
    chunk_size    = 2

    // Tree model: NELSI Kishino Autocorrelated
    tree_model         = "nelsi_kishino"
    nelsi_v            = 0.3
    nelsi_initial_rate = 1.0
    nelsi_scale_mode   = "root_to_tip"
    rate_sd            = 0.0
    lba_ratio          = 1.0

    // Sequence simulator
    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    // Substitution & Distance Models
    model             = "WAG+G4"
    iqtree_model      = "WAG+G4"
    alpha             = 1.0
    dist_model        = "wag_gamma"
    psa_dist_model    = "poisson"
    mmseqs_dist_model = "linear"
    gap_open          = 20.0
    gap_extend        = 2.0

    // Pipeline Toggles
    run_pwa_nj       = true
    run_mmseqs_nj    = true
    run_msa_nj       = true
    run_nj_nni       = true
    nj_nni_type      = "B"
    run_msa_ml       = true
    run_msa_raxml    = true
    run_msa_linsi    = false
    run_msa_bi       = false
    run_bi           = false
    run_gs           = false

    // True MSA / PWA baselines (OFF for taxa-scaling run)
    run_true_pwa       = false
    run_true_msa_nj    = false
    run_true_msa_ml    = false
    run_true_msa_raxml = false
    run_true_msa_bi    = false
    run_true_bi        = false
    run_true_msa       = false

    // RAxML Settings
    raxml_model      = "PROTGAMMAIWAGX"

    // Output
    outdir           = "results/results_nelsi_taxa128_L500"

    // Tools
    nj_tool          = "rapidnj"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 6.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: CALCULATE_ALIGNMENT_METRICS {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 10.h * task.attempt }
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 10.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 10.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    withName: RUN_NJ_NNI {
        cpus   = 1
        memory = '4 GB'
        time   = '6h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory   = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - NELSI Taxa 128 (L=500)'
    author          = 'CitrusML'
    description     = 'NELSI Kishino autocorrelated model taxa-scaling benchmark (N=128, L=500).'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

