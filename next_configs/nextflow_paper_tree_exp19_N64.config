/*
 * Nextflow Configuration for Paper Tree Benchmark 19 (Exp19 - N = 64 Taxon Scaling)
 */

params {
    taxa          = 64
    distances     = [0.5, 1.0, 2.0]
    lengths       = [1000]
    replicates    = 50
    chunk_size    = 1

    tree_model    = "paper_yule"
    rate_sd       = 0.0
    lba_ratio     = 1.0
    birth_rate    = 0.1
    death_rate    = 0.05

    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    model         = "WAG+G4"
    alpha         = 1.0
    dist_model    = "poisson"
    gap_open      = 20.0
    gap_extend    = 2.0

    iqtree_model  = "WAG+G4"
    raxml_model   = "PROTGAMMAIWAGX"

    run_pwa_nj       = true
    run_mmseqs_nj    = true
    run_msa_nj       = true
    run_msa_ml       = true
    run_msa_raxml    = true
    run_msa_linsi    = true
    run_msa_bi       = false
    run_gs           = true

    run_true_pwa     = true
    run_true_msa_nj  = true
    run_true_msa_ml  = true
    run_true_msa_raxml = true
    run_true_msa_bi  = false
    run_true_msa     = true

    calc_sp          = true
    save_replications = true
    calc_sss         = true

    gs_sensitivity   = 7.5
    nj_tool          = "rapidnj"
    outdir           = "results/results_exp19_N64"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 6.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_MAFFT {
        cpus   = 4
        memory = { 10.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_MAFFT_LINSI {
        cpus   = 4
        memory = { 10.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '6 GB'
        time   = '4h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }

    withName: RUN_MSA_NJ_LINSI {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_MSA_ML_LINSI {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_MSA_RAXML_LINSI {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 2
        memory = '6 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_RAXML {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: CALCULATE_ALIGNMENT_METRICS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '1h'
        executor  = 'local'
    }
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 1
        process.executor  = 'local'
        process.cpus      = 2
        process.memory    = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - Paper Tree Benchmark 19 (N=64)'
    author          = 'CitrusML'
    homePage        = 'https://github.com/citrusml2004/PhyloTree_Methods_Comparison'
    description     = 'Exp19 N=64 Taxon Scaling Benchmark'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '19.0.0'
}
