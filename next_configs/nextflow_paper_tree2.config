/*
 * Nextflow Configuration for Paper Tree Benchmark 2 (INDELible 正式採用) — 実験16
 *
 * 論文 (Matsui & Iwasaki 2020, Systematic Biology) のシミュレーション条件を完全再現:
 *   - 配列シミュレータ: INDELible v1.03 (Gillespie 連続時間マルコフジャンプ過程)
 *   - 系統樹生成モデル (tree_model): 後退 Yule 過程 (Backward Yule process) + 対数分布枝長 (1 - ln(u*(e-1)+1))
 *   - Zipfian (Power-Law) べき乗則 Indel: POW 1.7 50 (べき指数 a=1.7, 最大 50 残基)
 *   - Indel 発生頻度: insert_rate=0.10, delete_rate=0.10 (論文指定 [indelrate] 0.1 / Fig. 3a 最強条件)
 *   - アミノ酸置換モデル: WAG + Gamma4 (alpha=1.0)
 *   - 比較手法: PWA+NJ, MSA+NJ, MSA+ML (IQ-TREE 2), MSA+RAXML (RAxML -f d), GS, 各種 True MSA 対照群
 *   - ギャップペナルティ: Gap Open = 20.0, Gap Extension = 2.0 (PhyPA / Xia 2016 準拠)
 *   - Distances: [0.1, 0.2, 0.5, 1.0, 1.5, 2.0] (論文 Fig. 3 条件に完全準拠)
 *   - Lengths: [1000]
 *   - Replicates: 30
 */

params {
    taxa          = 20
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths       = [1000]
    replicates    = 30
    chunk_size    = 5                        // 50 replicates を 1つの LSF ジョブにバッチ集約

    // 系統樹生成モデル (Matsui & Iwasaki 2020 準拠)
    tree_model    = "paper_yule"              // 後退 Yule 過程 + 枝長分布 1 - ln(u*(e-1)+1)
    rate_sd       = 0.0                       // 速度不均一の標準偏差 (デフォルト: 0.0)
    lba_ratio     = 1.0                       // 長枝牽引比率 (デフォルト: 1.0)
    birth_rate    = 0.1                       // birth_death フォールバック用
    death_rate    = 0.05                      // birth_death フォールバック用

    // シミュレータ指定 (論文完全準拠: INDELible v1.03)
    simulator     = "indelible"
    insert_rate   = 0.10                      // 挿入率 (論文指定 [indelrate] 0.1 準拠: 10%)
    delete_rate   = 0.10                      // 欠失率 (論文指定 [indelrate] 0.1 準拠: 10%)
    indel_size    = "POW 1.7 50"              // Zipfian: べき指数 a=1.7, 最大 50 残基

    model         = "WAG+G4"                  // 論文指定アミノ酸置換モデル: WAG + Gamma4
    alpha         = 1.0
    dist_model    = "poisson"
    gap_open      = 20.0
    gap_extend    = 2.0

    // =============================================================
    // パイプライン実行 ON / OFF スイッチ (個別モジュール制御)
    // =============================================================
    run_pwa_nj       = true   // Pairwise Alignment + NJ (PWA+NJ)
    run_msa_nj       = true   // MAFFT + NJ (MSA+NJ)
    run_msa_ml       = true   // MAFFT + IQ-TREE 2 (MSA+ML)
    run_msa_raxml    = true   // MAFFT + RAxML -f d (MSA+RAXML: 論文 Fig. 3a 再現用)
    run_msa_bi       = false  // MAFFT + MrBayes (MSA+BI)
    run_bi           = false  // run_msa_bi のエイリアス
    run_gs           = true   // Graph Splitting (GS / syz049 準拠)

    // 正解アライメント対照群 (True Controls)
    run_true_pwa     = true   // True Alignment + PWA + NJ
    run_true_msa_nj  = true   // True Alignment + NJ
    run_true_msa_ml  = true   // True Alignment + ML (IQ-TREE 2)
    run_true_msa_raxml = true // True Alignment + RAxML -f d
    run_true_msa_bi  = false  // True Alignment + MrBayes (True MSA+BI)
    run_true_bi      = false  // run_true_msa_bi のエイリアス
    run_true_msa     = true   // 互換スイッチ (true_msa_nj, true_msa_ml を一括制御)
    calc_sss         = true   // SSS (Sequence Similarity Score) 計算 (論文 Fig. 3a 再現・極限崩壊検証用)

    // ツール詳細オプション
    raxml_model      = "PROTGAMMAIWAGX" // RAxML アミノ酸置換モデル (Matsui & Iwasaki 2020 準拠: WAG + Gamma4 + I)
    bi_ngen          = 100000 // MrBayes MCMC世代数
    bi_samplefreq    = 1000   // MrBayes サンプリング間隔
    bi_burnin        = 20     // MrBayes バーンイン破棄数 (samples)
    bi_nchains       = 4      // MrBayes MCMCチェイン数
    bi_model         = "wag"  // MrBayes アミノ酸モデル (WAG)
    gs_sensitivity   = 7.5    // MMseqs2 sensitivity (syz049準拠: -m 7.5 最感度)
    outdir           = "results/results_paper_tree2"
    nj_tool          = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '3h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_BI {
        cpus   = 4
        memory = '8 GB'
        time   = '48h'
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_BI {
        cpus   = 4
        memory = '8 GB'
        time   = '48h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory    = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - Paper Tree Benchmark'
    author          = 'CitrusML'
    homePage        = 'https://github.com/citrusml2004/PhyloTree_Methods_Comparison'
    description     = 'Benchmark of PWA+NJ, MSA+NJ, MSA+ML, GS under Matsui & Iwasaki (2020) backward Yule tree with logarithmic branch length distribution.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '15.0.0'
}
