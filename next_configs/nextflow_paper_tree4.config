/*
 * Nextflow Configuration for Paper Tree Benchmark 4 (実験18: 論文距離行列・PSA+NJ 完全一致版)
 *
 * 論文 (Matsui & Iwasaki 2020, Systematic Biology, Fig. 3a) のシミュレーション条件・距離行列計算を完全再現:
 *   - 配列シミュレータ: INDELible v1.03 (連続時間マルコフジャンプ過程)
 *   - 系統樹生成モデル (tree_model): 後退 Yule 過程 (Backward Yule) + 対数分布枝長 (1 - ln(u*(e-1)+1))
 *   - Zipfian (べき乗則) Indel: POW 1.7 50 (べき指数 a=1.7, 最大 50 残基)
 *   - Indel 発生頻度: insert_rate=0.10, delete_rate=0.10 (論文 Fig. 3a 条件)
 *   - アミノ酸置換モデル: WAG + Gamma4 (alpha=1.0)
 *
 * 【実験18 (Paper Tree 4) における距離計算の原著完全統一】:
 *   1. PSA + NJ (PWA+NJ / MMSEQS+NJ):
 *      - 論文 p.268 "all-to-all pairwise sequence alignment is performed using MMseqs2 ...
 *        to calculate the symmetrical relative sequence similarity score (Dufour et al. 2010)" に完全準拠。
 *      - MMseqs2 (-s 7.5 -e 10) の bit score S'_bits(i,j) から相対類似度スコア
 *        w_ij = (S'_bits(i,j) + S'_bits(j,i)) / (S'_bits(i,i) + S'_bits(j,j)) を計算。
 *      - PWA+NJ (psa_dist_model = "mmseqs_linear"): d_ij = 1.0 - w_ij (線形非類似度変換 + NJ)
 *      - MMSEQS+NJ (mmseqs_dist_model = "log"):     d_ij = -ln(max(w_ij, 1e-4)) (対数距離変換 + NJ)
 *   2. MSA + NJ (MSA+NJ / MSA_LINSI+NJ / TRUE_MSA+NJ / TRUE_PWA+NJ):
 *      - 論文 p.268 "phangorn package with the WAG + Gamma model (NJ_MSA_p)" に完全準拠。
 *      - dist_model = "wag_gamma" により、WAG + 4カテゴリ離散 Gamma (alpha=1.0) 置換確率行列 P(d) の
 *        厳密最尤距離推定 d_ML = argmax_d sum L(d) を用いて距離行列を構築。
 *   3. MAFFT L-INS-i (run_msa_linsi = true):
 *      - 論文指定の mafft-linsi (L-INS-i) と mafft --auto の双方を同時実行・比較。
 */

params {
    taxa          = 20
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0]
    lengths       = [500, 1000, 1500]
    replicates    = 100
    chunk_size    = 20                        // 20 replicates を 1 つの LSF ジョブにバッチ集約

    // 系統樹生成モデル (Matsui & Iwasaki 2020 準拠)
    tree_model    = "paper_yule"              // 後退 Yule 過程 + 枝長分布 1 - ln(u*(e-1)+1)
    rate_sd       = 0.0                       // 速度不均一の標準偏差 (デフォルト: 0.0)
    lba_ratio     = 1.0                       // 長枝牽引比率 (デフォルト: 1.0)
    birth_rate    = 0.1                       // birth_death フォールバック用
    death_rate    = 0.05                      // birth_death フォールバック用

    // シミュレータ指定 (論文完全準拠: INDELible v1.03)
    simulator     = "indelible"
    insert_rate   = 0.10                      // 挿入率 (論文指定 [indelrate] 0.1 準拠: 10%)
    delete_rate   = 0.10                      // 欠失率 (論文指定 [indelrate] 0.1 準拠: 10%)
    indel_size    = "POW 1.7 50"              // Zipfian: べき指数 a=1.7, 最大 50 残基

    // 置換モデル・距離行列計算モデル (論文 syz049 完全準拠)
    model             = "WAG+G4"              // 論文指定アミノ酸置換モデル: WAG + Gamma4
    alpha             = 1.0                   // Gamma 形状パラメータ alpha = 1.0
    dist_model        = "wag_gamma"           // MSA+NJ / True系: phangorn::dist.ml 準拠の WAG+Gamma4 最尤距離
    psa_dist_model    = "mmseqs_linear"       // PWA+NJ: 論文 NJ_PSA 準拠 (MMseqs2 w_ij -> d_ij = 1 - w_ij)
    mmseqs_dist_model = "log"                 // MMSEQS+NJ: 論文 NJ_PSA 対数変換 (MMseqs2 w_ij -> d_ij = -ln(w_ij))
    gap_open          = 20.0                  // NW フォールバック用ギャップオープンペナルティ (PhyPA 準拠)
    gap_extend        = 2.0                   // NW フォールバック用ギャップ伸長ペナルティ (PhyPA 準拠)

    // =============================================================
    // パイプライン実行 ON / OFF スイッチ (個別モジュール制御)
    // =============================================================
    run_pwa_nj       = true   // PSA+NJ (MMseqs2 類似度 w_ij 線形距離 d = 1 - w_ij + NJ)
    run_mmseqs_nj    = true   // MMSEQS+NJ (MMseqs2 類似度 w_ij 対数距離 d = -ln(w_ij) + NJ)
    run_msa_nj       = true   // MAFFT (--auto) + WAG+Gamma4 ML距離 + NJ
    run_msa_ml       = true   // MAFFT (--auto) + IQ-TREE 2 (MSA+ML)
    run_msa_raxml    = true   // MAFFT (--auto) + RAxML -f d (MSA+RAXML: 論文 Fig. 3a 準拠)
    run_msa_linsi    = true   // MAFFT L-INS-i (mafft-linsi) + NJ / ML / RAxML (論文 Fig. 3a 完全準拠)
    run_msa_bi       = false  // MAFFT + MrBayes (MSA+BI)
    run_bi           = false  // run_msa_bi のエイリアス
    run_gs           = true   // Graph Splitting (GS / syz049 準拠)

    // 正解アライメント対照群 (True Controls)
    run_true_pwa       = true   // True Alignment + WAG+Gamma4 ML距離 + NJ
    run_true_msa_nj    = true   // True Alignment + WAG+Gamma4 ML距離 + NJ
    run_true_msa_ml    = true   // True Alignment + ML (IQ-TREE 2)
    run_true_msa_raxml = true   // True Alignment + RAxML -f d
    run_true_msa_bi    = false  // True Alignment + MrBayes (True MSA+BI)
    run_true_bi        = false  // run_true_msa_bi のエイリアス
    run_true_msa       = true   // 互換スイッチ (true_msa_nj, true_msa_ml を一括制御)

    // 評価・解析・保存スイッチ
    calc_sp           = true   // SP score (f_D) 相同残基ペア追跡によるアライメント精度評価
    save_replications = true   // 中間生データ (FASTA, 距離行列, 推定系統樹) の永続保存
    calc_sss          = true   // SSS (Sequence Similarity Score) 計算 (極限崩壊検証用)

    // ツール詳細オプション
    raxml_model      = "PROTGAMMAIWAGX" // RAxML アミノ酸置換モデル (WAG + Gamma4 + I)
    bi_ngen          = 100000 // MrBayes MCMC世代数
    bi_samplefreq    = 1000   // MrBayes サンプリング間隔
    bi_burnin        = 20     // MrBayes バーンイン破棄数 (samples)
    bi_nchains       = 4      // MrBayes MCMCチェイン数
    bi_model         = "wag"  // MrBayes アミノ酸モデル (WAG)
    gs_sensitivity   = 7.5    // MMseqs2 sensitivity (syz049準拠: -s 7.5 最感度)
    outdir           = "results/results_paper_tree4"
    nj_tool          = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '3h'
    }

    withName: CALCULATE_SSS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: CALCULATE_ALIGNMENT_METRICS {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MAFFT_LINSI {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_NJ_LINSI {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_ML_LINSI {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML_LINSI {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_BI {
        cpus   = 4
        memory = '8 GB'
        time   = '48h'
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_RAXML {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_TRUE_MSA_BI {
        cpus   = 4
        memory = '8 GB'
        time   = '48h'
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        executor  = 'local'
    }
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true'
    }

    test {
        params.taxa       = 8
        params.distances  = [0.5, 2.0]
        params.lengths    = [300]
        params.replicates = 2
        params.chunk_size = 2
        process.executor  = 'local'
        process.cpus      = 2
        process.memory    = '4 GB'
    }
}

manifest {
    name            = 'PhyloTree_Methods_Comparison - Paper Tree Benchmark 4 (Exact Paper Distance)'
    author          = 'CitrusML'
    homePage        = 'https://github.com/citrusml2004/PhyloTree_Methods_Comparison'
    description     = 'Exact reproduction of Matsui & Iwasaki (2020) Fig. 3a with MMseqs2 w_ij PSA+NJ and WAG+Gamma4 ML distance for MSA+NJ.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '18.0.0'
}

