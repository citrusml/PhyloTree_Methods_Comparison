/*
 * Nextflow Configuration for Method Comparison Benchmark 2 (main2.nf)
 * Evaluates under updated MIN_OVERLAP = 10 pairwise distance calculation
 * Chunked Execution: 50 reps/job
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa         = 32
    distances    = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths      = [100, 300, 500, 1000, 1500]
    replicates   = 100
    chunk_size   = 50                        // 50 replicates を 1つの LSF ジョブにバッチ集約
    birth_rate   = 0.1
    death_rate   = 0.05
    insert_rate  = 0.05
    delete_rate  = 0.10
    model        = "LG+G4"
    alpha        = 1.0
    dist_model   = "poisson"
    gap_open     = 10.0
    gap_extend   = 0.5
    run_true_msa = true
    run_true_dist = true
    outdir       = "results/results2"
    nj_tool      = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '4h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '12h'                     // 50 reps x ~2-5min = ~2-4h (安全マージン12h)
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '12h'
    }

    withName: RUN_TRUE_DIST_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 300
    pollInterval      = '2sec'
    queueStatInterval = '5sec'
    submitRateLimit   = '30/1sec'
}

profiles {
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }
}

manifest {
    name            = 'PhyloMethod Benchmark 2'
    description     = 'Benchmark of PWA+NJ, MSA+NJ, MSA+ML, TRUE_MSA+NJ, TRUE_MSA+ML, and TRUE_DIST+NJ under updated MIN_OVERLAP'
    mainScript      = 'main2.nf'
    nextflowVersion = '>=23.04.0'
}
