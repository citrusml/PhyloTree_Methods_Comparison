/*
 * Nextflow Configuration for Full-length Invariant Category Sites (ICS Full) Benchmark
 * Experiment 11: Evaluation of 100% Dayhoff 6-category Invariant Sites with Indels
 * Tailored for LSF Cluster / Local environment
 */

params {
    taxa        = 32
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 300, 500, 1000, 1500]
    ics_prop    = 1.0                         // 全長 (100%) ICS
    replicates  = 100
    chunk_size  = 10                          // 10 replicates を 1つのバッチジョブに集約
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG+G4"
    alpha       = 1.0                         // 固定ガンマ形状パラメータ
    dist_model  = "poisson"
    gap_open    = 10.0
    gap_extend  = 0.5
    outdir      = "results/results_ics_full"
    nj_tool     = "rapidnj"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 300
    pollInterval      = '2sec'
    queueStatInterval = '5sec'
    submitRateLimit   = '30/1sec'
}

profiles {
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }
}

manifest {
    name            = 'PhyloMethod Full-length ICS Benchmark'
    description     = 'Benchmark of PWA+NJ vs MSA+NJ and MSA+ML under 100% Invariant Category Sites with Indels'
    mainScript      = 'main_ics_full.nf'
    nextflowVersion = '>=23.04.0'
}
