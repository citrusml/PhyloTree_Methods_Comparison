/*
 * Nextflow Configuration for Paper Tree Benchmark 19 (Exp19)
 *
 * 論文 (Matsui & Iwasaki 2020, Systematic Biology) の完全再現と差異解明:
 *   1. MMSEQS+NJ (論文準拠の局所 SSS ビットスコア + NJ) を新規追加
 *   2. MAFFT-LINSI (L-INS-i) と MAFFT --auto の直接対比
 *   3. 論文指定置換モデル (WAG+G4) の明示固定指定
 *   4. 多Taxonスケーリング (N = 20, 64, 128)
 *   5. 極限低類似度領域 (D = 0.1 .. 3.0)
 */

params {
    taxa          = 20
    distances     = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0, 3.0]
    lengths       = [1000]
    replicates    = 50
    chunk_size    = 10

    // 系統樹生成モデル (Matsui & Iwasaki 2020 準拠)
    tree_model    = "paper_yule"
    rate_sd       = 0.0
    lba_ratio     = 1.0
    birth_rate    = 0.1
    death_rate    = 0.05

    // シミュレータ指定 (論文完全準拠: INDELible v1.03)
    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    // 置換モデル (論文完全一致: WAG + Gamma4)
    model         = "WAG+G4"
    alpha         = 1.0
    dist_model    = "poisson"
    gap_open      = 20.0
    gap_extend    = 2.0

    // 手法別モデル指定 (論文指定モデル完全固定)
    iqtree_model  = "WAG+G4"         // IQ-TREE 2 で真のモデル WAG+G4 を固定指定
    raxml_model   = "PROTGAMMAIWAGX" // RAxML -f d (論文指定モデル)

    // 手法スイッチ
    run_pwa_nj       = true   // Pairwise Alignment + NJ (Needleman-Wunsch)
    run_mmseqs_nj    = true   // MMseqs2 SSS-based Pairwise Alignment + NJ (論文準拠 NJ_PSA)
    run_msa_nj       = true   // MAFFT (--auto) + RapidNJ
    run_msa_ml       = true   // MAFFT (--auto) + IQ-TREE 2 (-m WAG+G4)
    run_msa_raxml    = true   // MAFFT (--auto) + RAxML (-f d)
    run_msa_linsi    = true   // MAFFT-LINSI + (NJ, ML, RAXML)
    run_msa_bi       = false  // MrBayes
    run_gs           = true   // Graph Splitting (gs2 -m 7.5)

    // 正解アライメント対照群
    run_true_pwa     = true
    run_true_msa_nj  = true
    run_true_msa_ml  = true
    run_true_msa_raxml = true
    run_true_msa_bi  = false
    run_true_msa     = true

    // 評価スイッチ
    calc_sp          = true
    save_replications = true
    calc_sss         = true

    gs_sensitivity   = 7.5
    nj_tool          = "rapidnj"
    outdir           = "results/results_exp19"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MAFFT_LINSI {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_GS {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_MSA_ML_LINSI {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: RUN_MSA_RAXML_LINSI {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '1h'
        executor  = 'local'
    }
}
