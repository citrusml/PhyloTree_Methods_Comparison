/*
 * Nextflow Configuration for PhyloMethod Taxon Benchmark (N = 8, 16, 64, 128)
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa        = [8, 16, 64, 128]
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 500, 1000]
    replicates  = 100
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG+G4"
    alpha       = 1.0
    gap_open    = 10.0
    gap_extend  = 0.5
    dist_model  = "poisson"
    outdir      = "results/results_taxon"
    nj_tool     = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        // IQ-TREE 2-thread parallelization for maximum cluster concurrency
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: COLLECT_AND_PLOT {
        cpus   = 4
        memory = '16 GB'
        time   = '1h'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 160
    pollInterval      = '2sec'
    queueStatInterval = '10sec'
    submitRateLimit   = '20/1sec'
}

profiles {
    supercomputer {
        params.taxa       = [8, 16, 64, 128]
        params.distances  = [0.1, 0.5, 1.0, 2.0, 3.0]
        params.lengths    = [100, 500, 1000]
        params.replicates = 100
    }

    local {
        params.taxa       = [8, 16]
        params.distances  = [0.1, 1.0]
        params.lengths    = [100, 500]
        params.replicates = 2
        process {
            executor = 'local'
            cpus     = 4
            memory   = '8 GB'
        }
        executor {
            cpus = 4
        }
    }
}

manifest {
    name            = 'PhyloMethod Taxon Benchmark'
    description     = 'Taxon Scaling Benchmark (N=8,16, 64, 128) across Distance and Length'
    mainScript      = 'next_main/main_taxon.nf'
    nextflowVersion = '>=23.04.0'
}
