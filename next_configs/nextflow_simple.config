/*
 * Nextflow Configuration for Simple Condition(LG model) Benchmark (Batch Chunking: 20 reps/job)
 * Experiment 9: Evaluation across sequence lengths (L = 100, 300, 500, 1000, 1500)
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa        = 32
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 300, 500, 1000, 1500]
    replicates  = 100
    chunk_size  = 20                        // 10 replicates を 1つの LSF ジョブにバッチ集約
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG"
    alpha       = 1.0  
    dist_model  = "poisson"
    gap_open    = 10.0
    gap_extend  = 0.5
    outdir      = "results/results_simple"
    nj_tool     = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'                      // 10 reps x 2min = 20min (安全マージン4h)
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 300
    pollInterval      = '2sec'
    queueStatInterval = '5sec'
    submitRateLimit   = '30/1sec'
}

profiles {
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }
}

manifest {
    name            = 'PhyloMethod Simple Condition Benchmark'
    description     = 'Benchmark of PWA+NJ vs MSA+NJ and MSA+ML under simple evolution model'
    mainScript      = 'main_simple.nf'
    nextflowVersion = '>=23.04.0'
}
