/*
 * Nextflow Configuration for FastME Options Benchmark (Batch Chunking: 10 reps/job)
 * Experiment 10: Evaluation of Advanced FastME Tree Inference (LG+G and SPR) across Distance D x Length L
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    taxa        = 32
    distances   = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths     = [100, 300, 500, 1000, 1500]
    replicates  = 100
    chunk_size  = 10                        // 10 replicates を 1つの LSF ジョブにバッチ集約
    birth_rate  = 0.1
    death_rate  = 0.05
    insert_rate = 0.05
    delete_rate = 0.10
    model       = "LG+G4"
    alpha       = 1.0
    dist_model  = "poisson"
    gap_open    = 10.0
    gap_extend  = 0.5
    run_ml      = true
    outdir      = "results/results_fastme_options"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_FASTME_SPR {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_FASTME_LG_G {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: COLLECT_AND_PLOT {
        executor = 'local'
        cpus     = 1
        memory   = '8 GB'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 300
    pollInterval      = '2sec'
    queueStatInterval = '5sec'
    submitRateLimit   = '30/1sec'
}

profiles {
    local {
        params.distances  = [0.1, 1.0]
        params.lengths    = [100, 500]
        params.replicates = 2
        params.chunk_size = 2
        process {
            executor = 'local'
            cpus     = 2
            memory   = '4 GB'
        }
        executor {
            cpus = 2
        }
    }

    supercomputer {
        process.executor = 'lsf'
        process.queue    = 'mafft'
    }
}

manifest {
    name            = 'PhyloMethod FastME Options Benchmark'
    description     = 'Benchmark of PWA+FastME_SPR vs MSA+FastME_LG_G and MSA+ML across distance and length'
    mainScript      = 'main_fastme_options.nf'
    nextflowVersion = '>=23.04.0'
}
