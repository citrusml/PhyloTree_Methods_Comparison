/*
 * Nextflow Configuration for Paper Tree Benchmark 19 (Exp19 - N = 128 Taxon Scaling)
 */

params {
    taxa          = 128
    distances     = [0.5, 1.0, 2.0]
    lengths       = [1000]
    replicates    = 50
    chunk_size    = 1

    tree_model    = "paper_yule"
    rate_sd       = 0.0
    lba_ratio     = 1.0
    birth_rate    = 0.1
    death_rate    = 0.05

    simulator     = "indelible"
    insert_rate   = 0.10
    delete_rate   = 0.10
    indel_size    = "POW 1.7 50"

    model         = "WAG+G4"
    alpha         = 1.0
    dist_model    = "poisson"
    gap_open      = 20.0
    gap_extend    = 2.0

    iqtree_model  = "WAG+G4"
    raxml_model   = "PROTGAMMAIWAGX"

    run_pwa_nj       = true
    run_mmseqs_nj    = true
    run_msa_nj       = true
    run_msa_ml       = true
    run_msa_raxml    = true
    run_msa_linsi    = true
    run_msa_bi       = false
    run_gs           = true

    run_true_pwa     = true
    run_true_msa_nj  = true
    run_true_msa_ml  = true
    run_true_msa_raxml = true
    run_true_msa_bi  = false
    run_true_msa     = true

    calc_sp          = true
    save_replications = true
    calc_sss         = true

    gs_sensitivity   = 7.5
    nj_tool          = "rapidnj"
    outdir           = "results/results_exp19_N128"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 8.GB * task.attempt }
    time   = { 8.h * task.attempt }

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '6 GB'
        time   = '3h'
    }

    withName: RUN_MAFFT_LINSI {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MMSEQS_NJ {
        cpus   = 4
        memory = '8 GB'
        time   = '3h'
    }

    withName: RUN_GS {
        cpus   = 4
        memory = '8 GB'
        time   = '3h'
    }

    withName: RUN_MSA_ML {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_ML_LINSI {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: RUN_MSA_RAXML_LINSI {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: COLLECT_AND_PLOT {
        cpus      = 2
        memory    = '8 GB'
        time      = '1h'
        executor  = 'local'
    }
}
