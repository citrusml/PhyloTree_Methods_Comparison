/*
 * Nextflow Configuration for PhyloMethod Benchmark
 * Tailored for LSF Cluster: 5 nodes (mafftsrv1-5) x 32 CPUs x 251.6GB RAM (160 CPUs total)
 */

params {
    distances     = [0.1, 0.5, 1.0, 2.0, 3.0]
    lengths       = [100, 300, 500, 1000, 1500]
    replicates    = 100
    num_taxa      = 32
    birth_rate    = 0.1
    death_rate    = 0.05
    insert_rate   = 0.05
    delete_rate   = 0.10
    model         = "LG+G4"
    alpha         = 1.0
    gap_open      = 10.0
    gap_extend    = 0.5
    dist_model    = "poisson"
    run_true_msa  = true
    run_true_dist = true
    outdir        = "results"
    nj_tool       = "rapidnj"
}

// Default execution environment: LSF Cluster (mafftsrv1-5)
process {
    executor      = 'lsf'
    queue         = 'mafft'
    // retry: ノード障害で終了しても別ノードで再試行する（最大5回）
    // collect(remainder:true) と組み合わせることで完走を保証する
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: SIMULATE_DATA {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }

    withName: RUN_PWA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MAFFT {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_MSA_ML {
        // IQ-TREE 2-thread parallelization for maximum cluster concurrency (80 simultaneous jobs on 160 CPUs)
        cpus   = 2
        memory = '8 GB'
        time   = '3h'
    }

    withName: RUN_TRUE_MSA_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: RUN_TRUE_MSA_ML {
        cpus   = 2
        memory = '8 GB'
        time   = '3h'
    }

    withName: RUN_TRUE_DIST_NJ {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: COLLECT_AND_PLOT {
        cpus   = 4
        memory = '16 GB'
        time   = '1h'
    }
}

executor {
    name              = 'lsf'
    queueSize         = 160
    pollInterval      = '2sec'
    queueStatInterval = '10sec'
    submitRateLimit   = '20/1sec'
}

profiles {
    supercomputer {
        params.distances  = [0.1, 0.5, 1.0, 2.0, 3.0]
        params.lengths    = [100, 300, 500, 1000, 1500]
        params.replicates = 100
    }

    local {
        params.distances  = [0.1, 1.0]
        params.lengths    = [100, 500]
        params.replicates = 5
        process {
            executor = 'local'
            cpus     = 4
            memory   = '8 GB'
        }
        executor {
            cpus = 4
        }
    }
}

manifest {
    name            = 'PhyloMethod Benchmark'
    description     = 'PWA+NJ vs MSA+ML Regime Map Benchmark Pipeline for LSF Cluster'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}
