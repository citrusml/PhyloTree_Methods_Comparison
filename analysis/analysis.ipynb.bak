   "source": [
    "# 全実験を統合した SSS 領域別の手法間精度比較 (Twilight Zone SSS <= 0.03 vs 通常領域)\n",
    "df_valid_sss = df_all.dropna(subset=['sss', 'nrf_distance']).copy()\n",
    "df_valid_sss['sss_regime'] = pd.cut(\n",
    "    df_valid_sss['sss'],\n",
    "    bins=[0.0, 0.03, 0.06, 0.15, 1.0],\n",
    "    labels=['Extreme (≤0.03)', 'Crossover (0.03-0.06]', 'Moderate (0.06-0.15]', 'High (>0.15)']\n",
    ")\n",
    "\n",
    "summary_by_regime = df_valid_sss.groupby(['sss_regime', 'pipeline'])['nrf_distance'].agg(['count', 'mean', 'std']).reset_index()\n",
    "pivot_regime = summary_by_regime.pivot_table(index='pipeline', columns='sss_regime', values='mean').round(4)\n",
    "print(\"=== Mean Normalized RF Distance by SSS Regime (All Experiments Combined) ===\")\n",
    "pivot_regime\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "83fac351",
   "metadata": {},
   "source": [
    "---\n",
    "## 6. Paper Tree 3: 系統樹推定の誤差逆伝播（Error Propagation Cascade）解析\n",
    "\n",
    "系統樹推定パイプラインにおける誤差は、以下の 4 段階のカスケードを経て増幅・伝播します：\n",
    "1. **(a) 変異・進化距離 ($D$) $\\rightarrow$ 多重整列精度 ($SP$ スコア)**: 進化距離の増大に伴うアラインメント情報の破綻\n",
    "2. **(b) 多重整列精度 ($SP$ スコア) $\\rightarrow$ 距離行列推定誤差 ($\\\\text{MAE}$)**: ギャップ誤配置による残基一致度低下とパトリスティック距離の過大・過小評価\n",
    "3. **(c) 距離行列推定誤差 ($\\\\text{MAE}$) $\\rightarrow$ 系統樹トポロジー誤差 ($nRF$)**: 距離行列の歪みがクラスタリング（NJ / FastME）のトポロジー決定に与える影響\n",
    "4. **(d) 多重整列精度 ($SP$ スコア) $\\rightarrow$ トポロジー復元精度 ($nRF$ / RCRB)**: アラインメント精度が各推定手法（ML vs RAxML vs NJ vs GS）の最終系統樹に与える直接感度\n",
    "\n",
    "`results/results_paper_tree3/benchmark_summary.csv` に記録された 16,200 推定データセットから、この誤差伝播チェーンを定量的に可視化・分析します。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "60ef4cb6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Loaded 16,200 records from Paper Tree 3\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x1440 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Paper Tree 3 誤差伝播データのロードと 4 パネルカスケード可視化\n",
    "pt3_csv_path = RESULTS_DIR / \"results_paper_tree3\" / \"benchmark_summary.csv\"\n",
    "\n",
    "if pt3_csv_path.exists():\n",
    "    df_pt3 = pd.read_csv(pt3_csv_path)\n",
    "    df_pt3['pipeline'] = df_pt3['pipeline'].astype(str).str.replace('PWA', 'PSA')\n",
    "    print(f\"✓ Loaded {len(df_pt3):,} records from Paper Tree 3\")\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "    ((ax_a, ax_b), (ax_c, ax_d)) = axes\n",
    "    \n",
    "    rep_level = df_pt3.drop_duplicates(subset=['distance', 'length', 'replicate']).copy()\n",
    "    \n",
    "    # (a) D -> SP score\n",
    "    sns.boxplot(data=rep_level, x=\"distance\", y=\"sp_score\", ax=ax_a, color=\"#9ecae1\", width=0.5, fliersize=2)\n",
    "    sns.stripplot(data=rep_level, x=\"distance\", y=\"sp_score\", ax=ax_a, color=\"#3182bd\", alpha=0.3, size=4, jitter=0.2)\n",
    "    ax_a.set_title(\"Divergence (D) → MSA Accuracy (SP Score)\", fontsize=11, fontweight='bold')\n",
    "    ax_a.set_xlabel(\"Evolutionary Distance (D)\", fontsize=10)\n",
    "    ax_a.set_ylabel(\"Sum-of-Pairs (SP) Score\", fontsize=10)\n",
    "    ax_a.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "    \n",
    "    # (b) SP score -> Distance MAE (散布図, 回帰直線なし)\n",
    "    for pipe in ['PSA+NJ', 'MSA+NJ']:\n",
    "        p_data = df_pt3[df_pt3['pipeline'] == pipe].dropna(subset=['sp_score', 'dist_mae'])\n",
    "        if len(p_data) > 0:\n",
    "            color = PIPELINE_COLORS.get(pipe, '#333333')\n",
    "            ax_b.scatter(p_data['sp_score'], p_data['dist_mae'], color=color, alpha=0.3, label=pipe, s=20)\n",
    "    ax_b.set_title(\"(b) MSA Accuracy (SP Score) → Distance Error (MAE)\", fontsize=11, fontweight='bold')\n",
    "    ax_b.set_xlabel(\"SP Score\", fontsize=10)\n",
    "    ax_b.set_ylabel(\"Distance Matrix MAE\", fontsize=10)\n",
    "    ax_b.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "    ax_b.legend(fontsize=9)\n",
    "    \n",
    "    # (c) Distance MAE -> nRF\n",
    "    for pipe in ['PSA+NJ', 'MSA+NJ']:\n",
    "        p_data = df_pt3[df_pt3['pipeline'] == pipe].dropna(subset=['dist_mae', 'nrf_distance'])\n",
    "        if len(p_data) > 0:\n",
    "            color = PIPELINE_COLORS.get(pipe, '#333333')\n",
    "            ax_c.scatter(p_data['dist_mae'], p_data['nrf_distance'], color=color, alpha=0.3, label=pipe, s=20)\n",
    "            m, b = np.polyfit(p_data['dist_mae'], p_data['nrf_distance'], 1)\n",
    "            xs = np.linspace(p_data['dist_mae'].min(), p_data['dist_mae'].max(), 50)\n",
    "            ax_c.plot(xs, m * xs + b, color=color, linestyle=\"--\", linewidth=2)\n",
    "    ax_c.set_title(\"Distance Error (MAE) → Tree Topology Error (nRF)\", fontsize=11, fontweight='bold')\n",
    "    ax_c.set_xlabel(\"Distance Matrix MAE\", fontsize=10)\n",
    "    ax_c.set_ylabel(\"Normalized RF Distance\", fontsize=10)\n",
    "    ax_c.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "    ax_c.legend(fontsize=9)\n",
    "    \n",
    "    # (d) SP score -> nRF across pipelines (散布図, 回帰直線なし)\n",
    "    cascade_pipes = ['MSA+ML', 'GS', 'MSA+RAXML', 'PSA+NJ', 'MSA+NJ']\n",
    "    for pipe in cascade_pipes:\n",
    "        p_data = df_pt3[df_pt3['pipeline'] == pipe].dropna(subset=['sp_score', 'nrf_distance'])\n",
    "        if len(p_data) > 0:\n",
    "            color = PIPELINE_COLORS.get(pipe, '#333333')\n",
    "            ax_d.scatter(p_data['sp_score'], p_data['nrf_distance'], color=color, alpha=0.25, s=15, label=pipe)\n",
    "    ax_d.set_title(\"(d) Direct Impact: SP Score → Tree Topology Error (nRF)\", fontsize=11, fontweight='bold')\n",
    "    ax_d.set_xlabel(\"Sum-of-Pairs (SP) Score\", fontsize=10)\n",
    "    ax_d.set_ylabel(\"Normalized RF Distance\", fontsize=10)\n",
    "    ax_d.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "    ax_d.legend(title=\"Pipeline\", loc='upper right', frameon=True, fontsize=9)\n",
    "    \n",
    "    plt.suptitle(\"Paper Tree 3: Phylogenetic Error Propagation Cascade (D → SP → MAE → nRF)\",\n",
    "                 fontsize=14, fontweight='bold', y=0.995)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print(f\"⚠️ {pt3_csv_path} not found.\")\n"
   ]
  },
