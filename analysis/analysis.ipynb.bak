   "source": [
    "# 誤差伝播の定量分析: パイプライン別 回帰傾き (Slope) & 相関係数 (R) サマリー\n",
    "regression_records = []\n",
    "for pipe in ['MSA+ML', 'GS', 'MSA+RAXML', 'PSA+NJ', 'MSA+NJ']:\n",
    "    p_data = df_pt3[df_pt3['pipeline'] == pipe].dropna(subset=['sp_score', 'nrf_distance'])\n",
    "    if len(p_data) < 10:\n",
    "        continue\n",
    "    slope, intercept, r_value, p_value, std_err = stats.linregress(p_data['sp_score'], p_data['nrf_distance'])\n",
    "    \n",
    "    # Extreme Zone (SSS <= 0.03) の平均 nRF\n",
    "    ext_data = p_data[p_data['sss_mean'] <= 0.03]\n",
    "    ext_nrf = ext_data['nrf_distance'].mean() if len(ext_data) > 0 else np.nan\n",
    "    ext_rcrb = ext_data['rcrb'].mean() if 'rcrb' in ext_data.columns and len(ext_data) > 0 else np.nan\n",
    "    \n",
    "    regression_records.append({\n",
    "        'Pipeline': pipe,\n",
    "        'SP -> nRF Slope (傾き)': round(slope, 4),\n",
    "        'Intercept (切片)': round(intercept, 4),\n",
    "        'Correlation (R)': round(r_value, 4),\n",
    "        'R^2 (決定係数)': round(r_value**2, 4),\n",
    "        'p-value': f\"{p_value:.2e}\",\n",
    "        'Extreme Zone (SSS≤0.03) Mean nRF': round(ext_nrf, 4) if pd.notna(ext_nrf) else 'N/A',\n",
    "        'Extreme Zone (SSS≤0.03) Mean RCRB': round(ext_rcrb, 4) if pd.notna(ext_rcrb) else 'N/A'\n",
    "    })\n",
    "\n",
    "reg_df = pd.DataFrame(regression_records)\n",
    "print(\"=== Error Propagation Cascade: Regression & Sensitivity Metrics ===\")\n",
    "reg_df\n"
   ]
  },
