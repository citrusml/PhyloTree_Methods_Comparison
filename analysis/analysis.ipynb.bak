   "source": [
    "# 実験別の概要テーブルを表示\n",
    "summary_overview = df_all.groupby([\"experiment_id\", \"experiment_name\", \"model\", \"dist_model\"]).agg(\n",
    "    num_taxa=(\"num_taxa\", lambda s: sorted(s.unique())),\n",
    "    distances=(\"distance\", lambda s: sorted(s.unique())),\n",
    "    lengths=(\"length\", lambda s: sorted(s.unique())),\n",
    "    alphas=(\"alpha\", lambda s: sorted(s.unique())),\n",
    "    ics_props=(\"ics_prop\", lambda s: sorted(s.unique())),\n",
    "    pipelines=(\"pipeline\", lambda s: sorted(s.unique())),\n",
    "    total_replicates=(\"replicate\", \"count\")\n",
    ").reset_index()\n",
    "\n",
    "summary_overview"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "86c366e2",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. 共通可視化ユーティリティ関数\n",
    "\n",
    "ベンチマーク解析で共通して使用するグラフ描画関数を定義します。\n",
    "- `plot_nrf_heatmap_grid`: パイプライン別の $D \\times L$ ヒートマップグリッド\n",
    "- `plot_nrf_by_distance`: 進化距離 $D$ に対する NRF distance の推移（配列長別サブプロット）\n",
    "- `plot_regime_map`: 2手法（PSA+NJ vs MSA+ML 等）の勝敗領域図（Regime Map）\n",
    "- `plot_nrf_vs_log_sss`: 横軸に対数スケール $\\log_{10}(SSS)$、縦軸にトポロジー誤差 $nRF$ をとり、全パイプラインの散布図および LOWESS 平滑化スプライン曲線を描画する汎用感度プロット関数\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "6add71b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# パイプライン別カラーパレット定義 (全パイプライン対応)\n",
    "PIPELINE_COLORS = {\n",
    "    'PSA+NJ': '#1f77b4',              # Blue\n",
    "    'PWA+NJ': '#1f77b4',              # Blue alias\n",
    "    'MSA+NJ': '#ff7f0e',              # Orange\n",
    "    'MSA+ML': '#2ca02c',              # Green\n",
    "    'GS': '#9467bd',                  # Purple (Graph Splitting)\n",
    "    'MSA+RAXML': '#8c564b',           # Brown (RAxML)\n",
    "    'TRUE_DIST+NJ': '#d62728',        # Red\n",
    "    'TRUE_DIST': '#d62728',           # Red\n",
    "    'TRUE_MSA+NJ': '#aec7e8',         # Light blue\n",
    "    'TRUE_MSA+ML': '#2ca02c',         # Dark green\n",
    "    'TRUE_MSA+RAXML': '#c49c94',      # Light brown\n",
    "    'TRUE_PSA+NJ': '#e377c2',         # Pink\n",
    "    'TRUE_PWA+NJ': '#e377c2',         # Pink alias\n",
    "    'PSA+FastME_NoOption': '#17becf', # Cyan\n",
    "    'PWA+FastME_NoOption': '#17becf', # Cyan alias\n",
    "    'MSA+FastME_NoOption': '#bcbd22', # Olive\n",
    "    'PSA+FastME_SPR': '#17becf',      # Cyan / Teal\n",
    "    'PWA+FastME_SPR': '#17becf',      # Cyan alias\n",
    "    'MSA+FastME_LG_G': '#8c564b',     # Brown\n",
    "}\n",
    "\n",
    "def plot_nrf_heatmap_grid(df_subset, title=\"Normalized RF Distance (NRF) Heatmap Grid\", annot=True):\n",
    "    \"\"\"\n",
    "    パイプラインごとに Distance x Length の NRF distance 平均値ヒートマップを描画\n",
    "    \"\"\"\n",
    "    pipelines = sorted(df_subset['pipeline'].unique())\n",
    "    n_pipes = len(pipelines)\n",
    "    cols = min(3, n_pipes)\n",
    "    rows = (n_pipes + cols - 1) // cols\n",
    "    \n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(cols * 4.8, rows * 4.0), squeeze=False)\n",
    "    fig.suptitle(title, fontsize=14, fontweight='bold', y=1.02)\n",
    "    \n",
    "    for idx, pipe in enumerate(pipelines):\n",
    "        r, c = idx // cols, idx % cols\n",
    "        ax = axes[r][c]\n",
    "        sub = df_subset[df_subset['pipeline'] == pipe]\n",
    "        pivot = sub.pivot_table(index='distance', columns='length', values='nrf_distance', aggfunc='mean')\n",
    "        \n",
    "        vmax = max(0.6, pivot.max().max()) if not pivot.empty and not pivot.isna().all().all() else 1.0\n",
    "        sns.heatmap(pivot, ax=ax, annot=annot, fmt='.3f', cmap='YlOrRd', vmin=0.0, vmax=vmax,\n",
    "                    cbar=True, cbar_kws={'label': 'Mean NRF Distance'})\n",
    "        ax.set_title(f\"Pipeline: {pipe}\", fontweight='bold')\n",
    "        ax.set_xlabel(\"Sequence Length (L)\")\n",
    "        ax.set_ylabel(\"Evolutionary Distance (D)\")\n",
    "        ax.invert_yaxis()\n",
    "    \n",
    "    for idx in range(n_pipes, rows * cols):\n",
    "        r, c = idx // cols, idx % cols\n",
    "        axes[r][c].axis('off')\n",
    "        \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def plot_nrf_by_distance(df_subset, title=\"NRF Distance vs Evolutionary Distance (D)\"):\n",
    "    \"\"\"\n",
    "    横軸: Evolutionary Distance D, 縦軸: NRF Distance, 色: Pipeline, 列: Sequence Length L\n",
    "    \"\"\"\n",
    "    lengths = sorted(df_subset['length'].unique())\n",
    "    n_lens = len(lengths)\n",
    "    cols = min(5, n_lens)\n",
    "    rows = (n_lens + cols - 1) // cols\n",
    "    \n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(cols * 3.8, rows * 3.5), squeeze=False, sharey=True)\n",
    "    fig.suptitle(title, fontsize=14, fontweight='bold', y=1.02)\n",
    "    \n",
    "    for idx, length in enumerate(lengths):\n",
    "        r, c = idx // cols, idx % cols\n",
    "        ax = axes[r][c]\n",
    "        sub = df_subset[df_subset['length'] == length]\n",
    "        \n",
    "        sns.lineplot(\n",
    "            data=sub, x='distance', y='nrf_distance', hue='pipeline',\n",
    "            palette=PIPELINE_COLORS, marker='o', ax=ax, errorbar=('ci', 95)\n",
    "        )\n",
    "        ax.set_title(f\"Length L = {length}\", fontweight='bold')\n",
    "        ax.set_xlabel(\"Evolutionary Distance (D)\")\n",
    "        ax.set_ylabel(\"NRF Distance\" if c == 0 else \"\")\n",
    "        ax.set_ylim(-0.02, min(1.0, max(0.6, sub['nrf_distance'].max() + 0.05)))\n",
    "        if idx > 0 and ax.get_legend():\n",
    "            ax.get_legend().remove()\n",
    "            \n",
    "    if axes[0][0].get_legend():\n",
    "        axes[0][0].legend(bbox_to_anchor=(1.05, 1), loc='upper left', frameon=True)\n",
    "        \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def plot_regime_map(df_subset, pipe_a='PSA+NJ', pipe_b='MSA+ML', title=None):\n",
    "    \"\"\"\n",
    "    D x L グリッドにおける pipe_a と pipe_b の精度差 (NRF_a - NRF_b) を可視化するRegime Map。\n",
    "    \"\"\"\n",
    "    if title is None:\n",
    "        title = f\"Regime Map: {pipe_a} vs {pipe_b} (Difference in Mean NRF)\"\n",
    "        \n",
    "    pivot_a = df_subset[df_subset['pipeline'] == pipe_a].pivot_table(index='distance', columns='length', values='nrf_distance', aggfunc='mean')\n",
    "    pivot_b = df_subset[df_subset['pipeline'] == pipe_b].pivot_table(index='distance', columns='length', values='nrf_distance', aggfunc='mean')\n",
    "    \n",
    "    diff = pivot_a - pivot_b\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))\n",
    "    \n",
    "    vlimit = max(abs(diff.min().min()), abs(diff.max().max()), 0.1)\n",
    "    sns.heatmap(diff, ax=ax1, annot=True, fmt='+.3f', cmap='RdBu_r', vmin=-vlimit, vmax=vlimit,\n",
    "                cbar_kws={'label': f'Mean NRF Difference ({pipe_a} - {pipe_b})\\n(< 0: {pipe_a} better | > 0: {pipe_b} better)'})\n",
    "    ax1.set_title(f\"NRF Difference ({pipe_a} - {pipe_b})\", fontweight='bold')\n",
    "    ax1.set_xlabel(\"Sequence Length (L)\")\n",
    "    ax1.set_ylabel(\"Evolutionary Distance (D)\")\n",
    "    ax1.invert_yaxis()\n",
    "    \n",
    "    winner_map = np.where(diff < -0.01, 1, np.where(diff > 0.01, -1, 0))\n",
    "    winner_df = pd.DataFrame(winner_map, index=diff.index, columns=diff.columns)\n",
    "    \n",
    "    cmap_cat = mpl.colors.ListedColormap([\"#2ca02c\", \"#d3d3d3\", \"#1f77b4\"])\n",
    "    sns.heatmap(winner_df, ax=ax2, cmap=cmap_cat, cbar=False, annot=False, linewidths=1, vmin=-1, vmax=1)\n",
    "    \n",
    "    for i in range(len(diff.index)):\n",
    "        for j in range(len(diff.columns)):\n",
    "            val = winner_df.iloc[i, j]\n",
    "            label = f\"{pipe_a}\\nWins\" if val == 1 else (f\"{pipe_b}\\nWins\" if val == -1 else \"Tie\")\n",
    "            ax2.text(j + 0.5, i + 0.5, label, ha='center', va='center', fontweight='bold', color='black')\n",
    "            \n",
    "    ax2.set_title(f\"Regime Partition: {pipe_a} (Blue) vs {pipe_b} (Green)\", fontweight='bold')\n",
    "    ax2.set_xlabel(\"Sequence Length (L)\")\n",
    "    ax2.set_ylabel(\"Evolutionary Distance (D)\")\n",
    "    ax2.invert_yaxis()\n",
    "    \n",
    "    plt.suptitle(title, fontsize=14, fontweight='bold', y=1.03)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# パイプライン別描画スタイル設定 (Matsui & Iwasaki 2020 準拠)\n",
    "PIPELINE_CONFIGS = {\n",
    "    \"MSA+ML\": {\"color\": \"#2ca02c\", \"label\": \"MSA+ML\", \"linestyle\": \"-\", \"linewidth\": 2.5, \"zorder\": 10},\n",
    "    \"MSA+RAXML\": {\"color\": \"#006400\", \"label\": \"MSA+RAXML\", \"linestyle\": \"-\", \"linewidth\": 2.2, \"zorder\": 9},\n",
    "    \"MSA+NJ\": {\"color\": \"#ff7f0e\", \"label\": \"MSA+NJ\", \"linestyle\": \"-\", \"linewidth\": 2.4, \"zorder\": 8},\n",
    "    \"PSA+NJ\": {\"color\": \"#1f77b4\", \"label\": \"PSA+NJ\", \"linestyle\": \"-\", \"linewidth\": 2.4, \"zorder\": 7},\n",
    "    \"PWA+NJ\": {\"color\": \"#1f77b4\", \"label\": \"PSA+NJ\", \"linestyle\": \"-\", \"linewidth\": 2.4, \"zorder\": 7},\n",
    "    \"GS\": {\"color\": \"#9467bd\", \"label\": \"GS\", \"linestyle\": \"-\", \"linewidth\": 2.6, \"zorder\": 11},\n",
    "    \"TRUE_MSA+ML\": {\"color\": \"#8c564b\", \"label\": \"TRUE_MSA+ML\", \"linestyle\": \"--\", \"linewidth\": 1.8, \"zorder\": 4},\n",
    "    \"TRUE_MSA+RAXML\": {\"color\": \"#c49c94\", \"label\": \"TRUE_MSA+RAXML\", \"linestyle\": \"-.\", \"linewidth\": 1.8, \"zorder\": 4},\n",
    "    \"TRUE_MSA+NJ\": {\"color\": \"#7f7f7f\", \"label\": \"TRUE_MSA+NJ\", \"linestyle\": \":\", \"linewidth\": 1.8, \"zorder\": 3},\n",
    "    \"TRUE_PSA+NJ\": {\"color\": \"#17becf\", \"label\": \"TRUE_PSA+NJ\", \"linestyle\": \"-.\", \"linewidth\": 2.0, \"zorder\": 5},\n",
    "    \"TRUE_PWA+NJ\": {\"color\": \"#17becf\", \"label\": \"TRUE_PSA+NJ\", \"linestyle\": \"-.\", \"linewidth\": 2.0, \"zorder\": 5},\n",
    "    \"TRUE_DIST+NJ\": {\"color\": \"#333333\", \"label\": \"TRUE_DIST+NJ\", \"linestyle\": \":\", \"linewidth\": 1.5, \"zorder\": 2},\n",
    "    \"PSA+FastME_NoOption\": {\"color\": \"#17becf\", \"label\": \"PSA+FastME\", \"linestyle\": \"-\", \"linewidth\": 2.2, \"zorder\": 8},\n",
    "    \"MSA+FastME_NoOption\": {\"color\": \"#bcbd22\", \"label\": \"MSA+FastME\", \"linestyle\": \"-\", \"linewidth\": 2.2, \"zorder\": 8},\n",
    "    \"PSA+FastME_SPR\": {\"color\": \"#e377c2\", \"label\": \"PSA+FastME_SPR\", \"linestyle\": \"-\", \"linewidth\": 2.4, \"zorder\": 9},\n",
    "    \"MSA+FastME_LG_G\": {\"color\": \"#bcbd22\", \"label\": \"MSA+FastME_LG_G\", \"linestyle\": \"-\", \"linewidth\": 2.4, \"zorder\": 9},\n",
    "}\n",
    "\n",
    "def plot_nrf_vs_log_sss(df_subset, title=\"Normalized RF Distance vs Sequence Similarity Score (SSS, Log Scale)\",\n",
    "                        pipelines=None, xlim=None):\n",
    "    \"\"\"\n",
    "    横軸: SSS (対数スケール log10), 縦軸: NRF Distance, 色・線種: Pipeline (全試行手法網羅対応)\n",
    "    散布図 + LOWESS 平滑化トレンドラインを描画\n",
    "    \"\"\"\n",
    "    if 'sss' not in df_subset.columns and 'sss_mean' in df_subset.columns:\n",
    "        df_subset = df_subset.copy()\n",
    "        df_subset['sss'] = df_subset['sss_mean']\n",
    "        \n",
    "    sub = df_subset.dropna(subset=['sss', 'nrf_distance']).copy()\n",
    "    sub = sub[sub['sss'] > 0]\n",
    "    \n",
    "    if pipelines is None:\n",
    "        avail = set(sub['pipeline'].unique())\n",
    "        preferred_order = [\n",
    "            'MSA+RAXML', 'TRUE_PSA+NJ', 'PSA+NJ', 'TRUE_MSA+ML', 'TRUE_MSA+NJ',\n",
    "            'TRUE_MSA+RAXML', 'GS', 'MSA+NJ', 'MSA+ML', 'TRUE_DIST+NJ',\n",
    "            'PSA+FastME_NoOption', 'MSA+FastME_NoOption', 'PSA+FastME_SPR', 'MSA+FastME_LG_G'\n",
    "        ]\n",
    "        pipelines = [p for p in preferred_order if p in avail]\n",
    "        for p in sub['pipeline'].unique():\n",
    "            if p not in pipelines:\n",
    "                pipelines.append(p)\n",
    "            \n",
    "    fig, ax = plt.subplots(figsize=(10, 6.2))\n",
    "    \n",
    "    from statsmodels.nonparametric.smoothers_lowess import lowess\n",
    "\n",
    "    for pipe in pipelines:\n",
    "        p_data = sub[sub['pipeline'] == pipe].sort_values('sss')\n",
    "        if len(p_data) == 0:\n",
    "            continue\n",
    "        cfg = PIPELINE_CONFIGS.get(pipe, {\n",
    "            'color': PIPELINE_COLORS.get(pipe, '#333333'),\n",
    "            'label': pipe.replace('PWA', 'PSA'),\n",
    "            'linestyle': '-',\n",
    "            'linewidth': 2.2,\n",
    "            'zorder': 5\n",
    "        })\n",
    "        \n",
    "        is_ctrl = 'TRUE' in pipe\n",
    "        alpha_val = 0.08 if is_ctrl else 0.18\n",
    "        s_val = 12 if is_ctrl else 16\n",
    "        \n",
    "        ax.scatter(p_data['sss'], p_data['nrf_distance'], color=cfg['color'],\n",
    "                   alpha=alpha_val, s=s_val, edgecolors='none', zorder=cfg.get('zorder', 5) - 1)\n",
    "        \n",
    "        x_vals = p_data['sss'].values\n",
    "        y_vals = p_data['nrf_distance'].values\n",
    "        valid = np.isfinite(x_vals) & np.isfinite(y_vals) & (x_vals > 0)\n",
    "        x_v, y_v = x_vals[valid], y_vals[valid]\n",
    "        \n",
    "        if len(x_v) >= 5:\n",
    "            sort_i = np.argsort(x_v)\n",
    "            x_s, y_s = x_v[sort_i], y_v[sort_i]\n",
    "            log_x = np.log10(x_s)\n",
    "            try:\n",
    "                lw = lowess(y_s, log_x, frac=0.30, it=3, return_sorted=True)\n",
    "                if np.allclose(lw[:, 1], y_s) or np.max(np.abs(np.diff(lw[:, 1]))) > 0.08:\n",
    "                    lw = lowess(y_s, log_x, frac=0.30, it=0, return_sorted=True)\n",
    "                ax.plot(10**lw[:, 0], lw[:, 1], color=cfg['color'], linestyle=cfg.get('linestyle', '-'),\n",
    "                        linewidth=cfg.get('linewidth', 2.2), label=cfg.get('label', pipe), zorder=cfg.get('zorder', 5))\n",
    "            except Exception:\n",
    "                p_fit = np.poly1d(np.polyfit(log_x, y_s, deg=2))\n",
    "                xs = np.linspace(log_x.min(), log_x.max(), 100)\n",
    "                ax.plot(10**xs, p_fit(xs), color=cfg['color'], linestyle=cfg.get('linestyle', '-'),\n",
    "                        linewidth=cfg.get('linewidth', 2.2), label=cfg.get('label', pipe), zorder=cfg.get('zorder', 5))\n",
    "            \n",
    "    ax.set_xscale('log')\n",
    "    if xlim is not None:\n",
    "        ax.set_xlim(xlim)\n",
    "    else:\n",
    "        min_x = max(0.005, sub['sss'].min() * 0.8)\n",
    "        max_x = min(1.05, max(0.2, sub['sss'].max() * 1.05))\n",
    "        ax.set_xlim(min_x, max_x)\n",
    "        \n",
    "    ax.set_ylim(-0.02, 1.02)\n",
    "    ax.set_xlabel(\"Sequence Similarity Score: SSS (log scale)\", fontsize=11, fontweight='bold')\n",
    "    ax.set_ylabel(\"Normalized Robinson-Foulds Distance: nRF\", fontsize=11, fontweight='bold')\n",
    "    if title:\n",
    "        ax.set_title(title, fontsize=13, fontweight='bold', pad=12)\n",
    "    ax.grid(True, which=\"both\", ls=\"--\", alpha=0.4)\n",
    "    ax.legend(loc='upper right', frameon=True, fontsize=10)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
