   "source": [
    "# ==============================================================================\n",
    "# 4.18.3 ICS Full (実験18) における ML 推定置換モデルの分布解析\n",
    "# ==============================================================================\n",
    "exp18_ml = df_all[(df_all['experiment_id'] == 'Exp18_ICSFull_PaperTree') & (df_all['pipeline'] == 'MSA+ML')]\n",
    "\n",
    "if not exp18_ml.empty and 'best_model_bic' in exp18_ml.columns:\n",
    "    fig, (ax1, ax2, ax3) = plt.subplots(1, 3, figsize=(20, 5.8), gridspec_kw={'width_ratios': [1.1, 2.0, 0.8], 'wspace': 0.8})\n",
    "    \n",
    "    # --- Panel (a): Top 10 Best-fit Models Barplot ---\n",
    "    model_counts = exp18_ml['best_model_bic'].value_counts()\n",
    "    top_models = model_counts.head(10)\n",
    "    \n",
    "    bar_colors = []\n",
    "    for m in top_models.index:\n",
    "        if m.startswith('Q.INSECT'):\n",
    "            bar_colors.append('#4c72b0')\n",
    "        elif m.startswith('LG'):\n",
    "            bar_colors.append('#55a868')\n",
    "        else:\n",
    "            bar_colors.append('#c44e52')\n",
    "    \n",
    "    y_pos = np.arange(len(top_models))\n",
    "    bars = ax1.barh(y_pos, top_models.values, color=bar_colors, edgecolor='black', linewidth=0.7, alpha=0.85)\n",
    "    ax1.set_yticks(y_pos)\n",
    "    ax1.set_yticklabels(top_models.index, fontsize=9.5)\n",
    "    ax1.invert_yaxis()\n",
    "    ax1.set_xlabel('Number of Replicates (Total = 1,200)', fontweight='bold')\n",
    "    ax1.set_title('(a) Top 10 Best-fit Substitution Models\\n[True Model: ICS+G4{1.0}]', fontweight='bold')\n",
    "    ax1.grid(True, linestyle='--', alpha=0.4, axis='x')\n",
    "    \n",
    "    for bar in bars:\n",
    "        w = bar.get_width()\n",
    "        pct = (w / len(exp18_ml)) * 100\n",
    "        ax1.text(w + 4, bar.get_y() + bar.get_height()/2, f'{int(w)} ({pct:.1f}%)',\n",
    "                 va='center', ha='left', fontsize=8.5, color='#222222')\n",
    "    ax1.set_xlim(0, max(top_models.values) * 1.25)\n",
    "    \n",
    "    from matplotlib.patches import Patch\n",
    "    legend_elements = [\n",
    "        Patch(facecolor='#4c72b0', edgecolor='k', label='Q.INSECT family'),\n",
    "        Patch(facecolor='#55a868', edgecolor='k', label='LG family')\n",
    "    ]\n",
    "    ax1.legend(handles=legend_elements, loc='lower right', frameon=True, fontsize=8.5)\n",
    "    \n",
    "    # --- Panel (b): Model Distribution Breakdown across Evolutionary Distance D ---\n",
    "    top6 = model_counts.head(6).index.tolist()\n",
    "    exp18_copy = exp18_ml.copy()\n",
    "    exp18_copy['model_grouped'] = exp18_copy['best_model_bic'].apply(lambda x: x if x in top6 else 'Other')\n",
    "    \n",
    "    ct = pd.crosstab(exp18_copy['distance'], exp18_copy['model_grouped'], normalize='index') * 100\n",
    "    col_order = [m for m in top6 if m in ct.columns] + ['Other']\n",
    "    ct = ct[col_order]\n",
    "    \n",
    "    colors = sns.color_palette(\"tab10\", len(col_order))\n",
    "    ct.plot(kind='bar', stacked=True, ax=ax2, color=colors, edgecolor='black', linewidth=0.5, alpha=0.9)\n",
    "    \n",
    "    ax2.set_xlabel('Evolutionary Distance ($D$)', fontweight='bold')\n",
    "    ax2.set_ylabel('Proportion of Selected Models (%)', fontweight='bold')\n",
    "    ax2.set_title('(b) Model Selection Breakdown vs Distance ($D$)', fontweight='bold')\n",
    "    ax2.set_xticklabels(ax2.get_xticklabels(), rotation=0)\n",
    "    ax2.set_ylim(0, 100)\n",
    "    ax2.grid(True, linestyle='--', alpha=0.4, axis='y')\n",
    "    ax2.legend(title='Selected Model (BIC)', bbox_to_anchor=(1.02, 1), loc='upper left', frameon=True, fontsize=8.5)\n",
    "    \n",
    "    # --- Panel (c): Rate Heterogeneity Distribution ---\n",
    "    def classify_heterogeneity(m):\n",
    "        if pd.isna(m): return 'Unknown'\n",
    "        if '+I+' in m or m.endswith('+I'):\n",
    "            return 'Invariant + Gamma/Rate (+I)'\n",
    "        elif '+R' in m:\n",
    "            return 'FreeRate (+R)'\n",
    "        elif '+G' in m:\n",
    "            return 'Gamma (+G4)'\n",
    "        else:\n",
    "            return 'Uniform'\n",
    "    \n",
    "    exp18_copy['rate_het'] = exp18_copy['best_model_bic'].apply(classify_heterogeneity)\n",
    "    het_counts = exp18_copy['rate_het'].value_counts()\n",
    "    het_colors = ['#2ca02c', '#1f77b4', '#ff7f0e', '#7f7f7f']\n",
    "    \n",
    "    wedges, texts, autotexts = ax3.pie(\n",
    "        het_counts.values, labels=het_counts.index, autopct='%1.1f%%',\n",
    "        colors=het_colors[:len(het_counts)], startangle=140,\n",
    "        wedgeprops=dict(edgecolor='k', linewidth=0.8, alpha=0.85),\n",
    "        textprops=dict(fontsize=8.5)\n",
    "    )\n",
    "    for at in autotexts:\n",
    "        at.set_fontsize(8.5)\n",
    "        at.set_weight('bold')\n",
    "    ax3.set_title('(c) Rate Heterogeneity Models\\n[True: Gamma(alpha=1.0)]', fontweight='bold')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # モデル選択の集計テーブル\n",
    "    print('=== Top Selected Models & Rate Heterogeneity in Exp18 (MSA+ML) ===')\n",
    "    display(pd.DataFrame({'Count': model_counts.head(10), 'Share (%)': (model_counts.head(10) / len(exp18_ml) * 100).round(2)}))\n",
    "else:\n",
    "    print('Warning: Exp18 ML benchmark data not found.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "24d8bf49",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. Sequence Similarity Score (SSS, 横軸対数スケール) 全実験横断解析\n",
    "\n",
    "配列類似度 $SSS$（Sequence Similarity Score, $w$）を共通の横軸（対数スケール $\\log_{10}(SSS)$）にとることで、異なるシミュレーション条件（幾何Indel vs べき乗則Zipfian Indel vs 後退Yule系統樹）を単一の物理的スケール上で横断比較します。\n",
    "\n",
    "特に、$w \u0007pprox 0.06$ 付近の **Crossover Zone** および $w \\le 0.03$ の **Extreme Twilight Zone** における各手法の感度曲線の挙動を検証します。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "281ab367",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1920x1320 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# 代表的な 4 実験における SSS (Log Scale) vs NRF Distance の 4 面比較プロット\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 11), sharey=True)\n",
    "\n",
    "target_exps = [\n",
    "    ('Exp1_Default', 'Exp1: Standard Base (Geometric Indel)', axes[0, 0]),\n",
    "    ('Exp14_ZipfianIndel', 'Exp14: Zipfian Heavy-Tailed Indel', axes[0, 1]),\n",
    "    ('Exp16_PaperTree2', 'Exp16: Paper Tree 2 (INDELible Fig. 3a)', axes[1, 0]),\n",
    "    ('Exp17_PaperTree3', 'Exp17: Paper Tree 3 (16,200 Estimations)', axes[1, 1]),\n",
    "]\n",
    "\n",
    "from statsmodels.nonparametric.smoothers_lowess import lowess\n",
    "\n",
    "for exp_id, title_name, ax in target_exps:\n",
    "    sub = df_all[df_all['experiment_id'] == exp_id].dropna(subset=['sss', 'nrf_distance'])\n",
    "    sub = sub[sub['sss'] > 0]\n",
    "    \n",
    "    \n",
    "    preferred_pipes = ['MSA+ML', 'GS', 'MSA+RAXML', 'PSA+NJ', 'MSA+NJ', 'TRUE_PSA+NJ']\n",
    "    pipes = [p for p in preferred_pipes if p in sub['pipeline'].unique()]\n",
    "    \n",
    "    for pipe in pipes:\n",
    "        p_data = sub[sub['pipeline'] == pipe].sort_values('sss')\n",
    "        if len(p_data) < 5:\n",
    "            continue\n",
    "        color = PIPELINE_COLORS.get(pipe, '#333333')\n",
    "        ax.scatter(p_data['sss'], p_data['nrf_distance'], color=color, alpha=0.18, s=15)\n",
    "        \n",
    "        try:\n",
    "            smooth = lowess(p_data['nrf_distance'], np.log10(p_data['sss']), frac=0.45, it=3)\n",
    "            ax.plot(10**smooth[:, 0], smooth[:, 1], color=color, linewidth=2.5, label=pipe)\n",
    "        except Exception:\n",
    "            pass\n",
    "            \n",
    "    ax.set_xscale('log')\n",
    "    ax.set_xlim(0.005, 1.05)\n",
    "    ax.set_ylim(-0.02, 1.02)\n",
    "    ax.set_title(title_name, fontsize=12, fontweight='bold')\n",
    "    ax.set_xlabel(\"Sequence Similarity Score (SSS, w) [Log Scale]\", fontsize=10)\n",
    "    ax.set_ylabel(\"Normalized RF Distance (nRF)\", fontsize=10)\n",
    "    ax.grid(True, which=\"both\", ls=\"--\", alpha=0.4)\n",
    "    if ax == axes[0, 0]:\n",
    "        ax.legend(loc='upper right', fontsize=9, frameon=True)\n",
    "\n",
    "plt.suptitle(\"Cross-Experiment Topological Error vs Sequence Similarity Score (SSS, Log Scale)\",\n",
    "             fontsize=14, fontweight='bold', y=0.995)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
