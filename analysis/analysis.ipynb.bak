   ],
   "source": [
    "# 統合データのロード\n",
    "# analysis/all_experiments_summary.csv が存在する場合は直接一括ロード（全18実験・225,340行・SSS列完備）\n",
    "out_csv_path = ANALYSIS_DIR / \"all_experiments_summary.csv\"\n",
    "\n",
    "if out_csv_path.exists():\n",
    "    print(f\"Loading pre-unified benchmark data from: {out_csv_path}...\")\n",
    "    df_all = pd.read_csv(out_csv_path)\n",
    "    # 型の補正\n",
    "    df_all[\"num_taxa\"] = df_all[\"num_taxa\"].astype(int)\n",
    "    df_all[\"distance\"] = df_all[\"distance\"].astype(float)\n",
    "    df_all[\"length\"] = df_all[\"length\"].astype(int)\n",
    "    df_all[\"replicate\"] = df_all[\"replicate\"].astype(int)\n",
    "    df_all[\"nrf_distance\"] = df_all[\"nrf_distance\"].astype(float)\n",
    "    df_all[\"pipeline\"] = df_all[\"pipeline\"].astype(str).str.replace(\"PWA\", \"PSA\")\n",
    "    if \"sss\" not in df_all.columns and \"sss_mean\" in df_all.columns:\n",
    "        df_all[\"sss\"] = df_all[\"sss_mean\"]\n",
    "        \n",
    "    print(f\"✓ Successfully loaded {len(df_all):,} rows across {df_all['experiment_id'].nunique()} experiments!\")\n",
    "    print(f\"  Experiments: {sorted(df_all['experiment_id'].unique())}\")\n",
    "    print(f\"  Available SSS columns: {[c for c in df_all.columns if 'sss' in c]}\")\n",
    "else:\n",
    "    raise FileNotFoundError(f\"{out_csv_path} does not exist.\")\n"
   ]
  },
