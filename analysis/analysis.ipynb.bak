   "source": [
    "# ==============================================================================\n",
    "# 4.18.2 MSA vs PSA SP スコア比較グラフ (Parity Scatter & Distance-dependent Decay)\n",
    "# ==============================================================================\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "sp_summary_path = RESULTS_DIR / \"results_ics_full\" / \"sample_alignments\" / \"alignment_samples_summary.csv\"\n",
    "\n",
    "if sp_summary_path.exists():\n",
    "    df_sp = pd.read_csv(sp_summary_path)\n",
    "    \n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6.5), gridspec_kw={'wspace': 0.25})\n",
    "    \n",
    "    # --- Panel (a): Parity Scatter Plot (PSA vs MSA) ---\n",
    "    # マーカー形状: 配列長 (Length L)\n",
    "    lengths = [300, 500, 1000, 1500]\n",
    "    length_markers = {300: 'o', 500: 's', 1000: '^', 1500: 'D'}\n",
    "    \n",
    "    # カラーパレット: 進化距離 (Distance D)\n",
    "    distances = sorted(df_sp['distance'].unique())\n",
    "    dist_colors = dict(zip(distances, sns.color_palette('viridis', len(distances))))\n",
    "    \n",
    "    for _, row in df_sp.iterrows():\n",
    "        d_val = row['distance']\n",
    "        l_val = int(row['length'])\n",
    "        ax1.scatter(\n",
    "            row['psa_sp_score'], row['sp_score'],\n",
    "            s=95, color=dist_colors[d_val], marker=length_markers[l_val],\n",
    "            edgecolors='black', linewidth=0.8, alpha=0.9, zorder=3\n",
    "        )\n",
    "    \n",
    "    min_val = min(df_sp['psa_sp_score'].min(), df_sp['sp_score'].min()) - 0.04\n",
    "    max_val = max(df_sp['psa_sp_score'].max(), df_sp['sp_score'].max()) + 0.03\n",
    "    ax1.plot([min_val, max_val], [min_val, max_val], 'k--', lw=1.5, alpha=0.6, label='y = x (Parity Line)', zorder=2)\n",
    "    \n",
    "    diff_mean = (df_sp['sp_score'] - df_sp['psa_sp_score']).mean()\n",
    "    \"\"\"\n",
    "    ax1.text(0.04, 0.94,\n",
    "             f'Mean $\\Delta$SP (MSA − PSA) = +{diff_mean:.4f}\\n'\n",
    "             f'• MSA exhibits slightly higher SP score (+0.01 ~ +0.10)\\n'\n",
    "             f'• PSA maintains robust accuracy without cumulative MSA distortion',\n",
    "             transform=ax1.transAxes, fontsize=9.5, verticalalignment='top',\n",
    "             bbox=dict(boxstyle='round,pad=0.5', facecolor='#f8f9fa', edgecolor='#cccccc', alpha=0.9))\n",
    "    \"\"\"\n",
    "    ax1.set_xlim(min_val, max_val)\n",
    "    ax1.set_ylim(min_val, max_val)\n",
    "    ax1.set_xlabel('PSA (Needleman-Wunsch) SP Score', fontweight='bold')\n",
    "    ax1.set_ylabel('MSA (MAFFT) SP Score', fontweight='bold')\n",
    "    ax1.set_title('(a) SP Score Correlation & Parity: MSA vs PSA', fontweight='bold')\n",
    "    ax1.grid(True, linestyle='--', alpha=0.4, zorder=1)\n",
    "    \n",
    "    # 2重凡例: 進化距離 (色) & 配列長 (形状)\n",
    "    dist_elements = [\n",
    "        Line2D([0], [0], marker='o', color='none', label=f'D = {d}',\n",
    "               markerfacecolor=dist_colors[d], markeredgecolor='k', markersize=7.5)\n",
    "        for d in distances\n",
    "    ]\n",
    "    length_elements = [\n",
    "        Line2D([0], [0], marker=length_markers[l], color='none', label=f'L = {l} aa',\n",
    "               markerfacecolor='#888888', markeredgecolor='k', markersize=7.5)\n",
    "        for l in lengths\n",
    "    ]\n",
    "    \n",
    "    leg_dist = ax1.legend(handles=dist_elements, title='Evolutionary Distance ($D$)',\n",
    "                          loc='lower right', bbox_to_anchor=(0.98, 0.23), frameon=True, fontsize=8.5, title_fontsize=9, ncol=2)\n",
    "    leg_len = ax1.legend(handles=length_elements, title='Sequence Length ($L$)',\n",
    "                         loc='lower right', bbox_to_anchor=(0.98, 0.02), frameon=True, fontsize=8.5, title_fontsize=9, ncol=2)\n",
    "    ax1.add_artist(leg_dist)\n",
    "    \n",
    "    # --- Panel (b): Grouped Bar Chart by Distance D ---\n",
    "    melted = []\n",
    "    for _, row in df_sp.iterrows():\n",
    "        melted.append({'distance': row['distance'], 'length': row['length'], 'method': 'MSA (MAFFT)', 'sp_score': row['sp_score']})\n",
    "        melted.append({'distance': row['distance'], 'length': row['length'], 'method': 'PSA (Needleman-Wunsch)', 'sp_score': row['psa_sp_score']})\n",
    "    df_melt = pd.DataFrame(melted)\n",
    "    \n",
    "    sns.barplot(\n",
    "        data=df_melt, x='distance', y='sp_score', hue='method',\n",
    "        palette={'MSA (MAFFT)': '#1f77b4', 'PSA (Needleman-Wunsch)': '#ff7f0e'},\n",
    "        ax=ax2, capsize=0.1, edgecolor='black', linewidth=0.8, alpha=0.75, zorder=2\n",
    "    )\n",
    "    \n",
    "    # 個別データ点を配列長ごとのマーカー形状でプロット (Jitter付きで4点が明確に分離)\n",
    "    dist_indices = {d: i for i, d in enumerate(distances)}\n",
    "    bar_offsets = {'MSA (MAFFT)': -0.2, 'PSA (Needleman-Wunsch)': 0.2}\n",
    "    l_jitters = {300: -0.06, 500: -0.02, 1000: 0.02, 1500: 0.06}\n",
    "    \n",
    "    for _, row in df_melt.iterrows():\n",
    "        d_idx = dist_indices[row['distance']]\n",
    "        x_pos = d_idx + bar_offsets[row['method']]\n",
    "        l_val = int(row['length'])\n",
    "        ax2.scatter(\n",
    "            x_pos + l_jitters[l_val], row['sp_score'],\n",
    "            marker=length_markers[l_val],\n",
    "            color='#084594' if row['method'].startswith('MSA') else '#b30000',\n",
    "            edgecolors='white', linewidth=0.6, s=55, alpha=0.9, zorder=4\n",
    "        )\n",
    "    \n",
    "    # サンプル数 (4配列長) の注記\n",
    "    ax2.text(0.03, 0.04, 'Note: 各棒の散布点 4 個は 4 つの配列長 ($L \\in [300, 500, 1000, 1500]$ aa, $n=4$) の各代表値を表します',\n",
    "             transform=ax2.transAxes, fontsize=8.5, color='#444444',\n",
    "             bbox=dict(boxstyle='square,pad=0.3', facecolor='#ffffff', edgecolor='#dddddd', alpha=0.8))\n",
    "    \n",
    "    handles, labels = ax2.get_legend_handles_labels()\n",
    "    ax2.legend(handles[:2], labels[:2], title='Alignment Method', loc='upper right', frameon=True, fontsize=9.5)\n",
    "    \n",
    "    ax2.set_xlabel('Evolutionary Distance ($D$)', fontweight='bold')\n",
    "    ax2.set_ylabel('Sum-of-Pairs (SP) Score', fontweight='bold')\n",
    "    ax2.set_title('(b) SP Score Comparison across Evolutionary Distance ($D$)', fontweight='bold')\n",
    "    ax2.set_ylim(0.4, 1.05)\n",
    "    ax2.grid(True, linestyle='--', alpha=0.4, axis='y', zorder=1)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # 数値サマリーテーブル\n",
    "    sp_table = df_melt.groupby(['distance', 'method'])['sp_score'].agg(['mean', 'std']).unstack()\n",
    "    print('=== SP Score Summary by Distance (Mean ± Std) ===')\n",
    "    display(sp_table.round(4))\n",
    "else:\n",
    "    print(f'Warning: {sp_summary_path} not found.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8f6435a8",
   "metadata": {},
   "source": [
    "---\n",
    "### 4.18.3 最尤法 (ML / IQ-TREE 2) の推定置換モデル分布解析 [真のモデル: ICS+G4{1.0}]\n",
    "- **背景と目的**:\n",
    "  - 実験18では、アミノ酸配列が全長保存ドメイン（100% Invariant Category Sites, `ICS+G4{1.0}`）および Zipfian べき乗則 Indel のもとで生成されています。\n",
    "  - 最尤系統樹推定法（`MSA+ML`, IQ-TREE 2）が実行する自動モデル選択（ModelFinder, BIC 規準）において、真のモデル（ICS）が探索候補に含まれない場合（モデル誤指定 / Model Misspecification）、どのような経験的置換行列やサイト間速度不均一性モデルが代償的に選好されるかを検証します。\n",
    "- **可視化の構成**:\n",
    "  - **(a) 選択頻度 Top 10 置換モデル**: 全 1,200 推定データセットにおける選択頻度（カウント & 占有率）\n",
    "  - **(b) 進化距離別のモデル推移**: 進化距離 $D$ の増大に伴うモデル複雑化・経験的周波数 (+F)・FreeRate (+R) へのシフト\n",
    "  - **(c) サイト間速度不均一性モデルの内訳**: Gamma (+G4) vs FreeRate (+R) vs 不変部位併用 (+I) の比率\n"
   ]
  },
